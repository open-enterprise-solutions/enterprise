# The demo's web server: every base of the running nightly, published on the loopback (web.conf, written by
# oes-demo-update.sh); Caddy is its door to the world. A stop is its TERM: it closes its bases and exits.

[Unit]
Description=OES demo - the web server and its bases
After=network-online.target
Wants=network-online.target

[Service]
User=oes
Group=oes
Environment=HOME=/opt/oes-demo
WorkingDirectory=/opt/oes-demo/current/oes
ExecStart=/opt/oes-demo/current/oes/webserver --dir=/opt/oes-demo/current/oes/web
TimeoutStopSec=30
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
