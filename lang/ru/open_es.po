msgstr "Активный"

#: src/engine/backend/metaCollection/partial/chartOfAccountsEnum.h:22
msgid "Passive"
msgstr "Пассивный"

#: src/engine/backend/metaCollection/partial/chartOfAccountsEnum.h:23
msgid "Active/Passive"
msgstr "Активно-пассивный"

