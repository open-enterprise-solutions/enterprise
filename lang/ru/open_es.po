msgstr "Развёрнутый остаток"

#: src/engine/backend/metaCollection/partial/registerQueryLowering.h:288
msgid "Opening gross balance"
msgstr "Начальный развёрнутый остаток"

#: src/engine/backend/metaCollection/partial/registerQueryLowering.h:289
msgid "Closing gross balance"
msgstr "Конечный развёрнутый остаток"

#: src/engine/backend/metaCollection/partial/registerQueryLowering.h:290
msgid "Corresponding turnover"
msgstr "Корреспондирующий оборот"

#: src/engine/backend/metaCollection/partial/registerQueryLowering.h:309
msgid "Cr"
msgstr "Кт"

#: src/engine/backend/metaCollection/partial/registerQueryLowering.h:309
