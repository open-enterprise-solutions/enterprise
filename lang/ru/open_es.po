msgstr "%s: у счетов (%i) больше %i аналитик - удалите из них лишние виды, прежде чем уменьшать предел"

#: src/engine/backend/metaCollection/partial/chartOfAccountsMetadataSchema.cpp:142
#, c-format
msgid "%s.%s: %i analytics are declared, the chart takes %i"
msgstr "%s.%s: объявлено аналитик: %i, план счетов принимает %i"

