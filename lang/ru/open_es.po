#, c-format
msgid "Register '%s': %u analytics slot(s) have no type - the chart of accounts names no characteristic chart, so nothing can be written into them"
msgstr "Регистр '%s': у слотов аналитики (%u) нет типа - в плане счетов не указан план видов характеристик, поэтому в них ничего нельзя записать"

#: src/engine/backend/metaCollection/partial/accountingRegisterMetadataSchema.cpp:175
