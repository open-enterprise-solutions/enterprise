#: src/engine/frmserver/visualView/ctrl/widgets.h:510
msgid "Source"
msgstr "Джерело"

#: src/engine/backend/metaCollection/metaEventHandlerObject.h:119
msgid "What raises the event: the objects, managers or record sets of one metaobject, or of every metaobject of a kind (DocumentObject - every document's object). Several may be named; the event is then one every one of them raises."
msgstr "Що викликає подію: об'єкти, менеджери або набори записів одного об'єкта метаданих чи всіх об'єктів метаданих одного виду (DocumentObject - об'єкт будь-якого документа). Можна вказати кілька; тоді подія - та, яку викликає кожен із них."

#: src/engine/backend/metaCollection/metaEventHandlerObject.h:120
#: src/engine/frmclient/docView/templates/docViewAuditLog.cpp:343
#: src/engine/frmserver/visualView/ctrl/formCommand.h:101
#: src/engine/frmserver/visualView/ctrl/gridBox.h:247
#: src/engine/frmserver/visualView/ctrl/notebook.h:77
#: src/engine/frmserver/visualView/ctrl/tableBox.h:445
