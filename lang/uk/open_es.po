msgid "expected a number after TOP"
msgstr "після TOP очікується число"

#: src/engine/core/query/queryParser.cpp:392
msgid "TOP expects a positive row count"
msgstr "TOP очікує додатну кількість рядків"

#: src/engine/core/query/queryParser.cpp:403
msgid "expected a temporary-table name after INTO"
msgstr "після INTO очікується ім'я тимчасової таблиці"

#: src/engine/core/query/queryParser.cpp:412
msgid "expected a name after ONTO"
msgstr "після ONTO очікується ім'я"

#: src/engine/core/query/queryParser.cpp:414
msgid "INTO and ONTO cannot both be written: INTO puts the result in a temporary table and returns none, ONTO names the result it returns"
msgstr "не можна вказувати одночасно INTO і ONTO: INTO поміщає результат у тимчасову таблицю і нічого не повертає, ONTO дає ім'я результату, що повертається"

#: src/engine/core/query/queryParser.cpp:479
msgid "ORDER BY cannot be written with INTO: a temporary table keeps rows, not an order"
msgstr "ORDER BY не можна вказувати з INTO: тимчасова таблиця зберігає рядки, а не порядок"

#: src/engine/core/query/queryParser.cpp:492
msgid "TOTALS cannot be written with INTO: a temporary table is a flat table, and TOTALS yields a tree"
msgstr "TOTALS не можна вказувати з INTO: тимчасова таблиця плоска, а TOTALS дає дерево"

#: src/engine/core/query/queryParser.cpp:511
msgid "INDEX BY needs INTO: only a temporary table this statement makes can be indexed"
msgstr "INDEX BY потребує INTO: індексувати можна лише тимчасову таблицю, яку створює цей оператор"

#: src/engine/core/query/queryParser.cpp:587
msgid "ROLE PERIOD takes a whole number from 1 to 999: which period is compared first"
msgstr "ROLE PERIOD приймає ціле число від 1 до 999: який період порівнюється першим"

#: src/engine/core/query/queryParser.cpp:610
#: src/engine/core/query/queryParser.cpp:696
#: src/engine/core/query/queryParser.cpp:962
#: src/engine/core/query/queryParser.cpp:1046
msgid "expected an alias name after AS"
msgstr "після AS очікується псевдонім"

#: src/engine/core/query/queryParser.cpp:642
