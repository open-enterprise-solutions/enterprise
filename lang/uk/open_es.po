msgstr "FOR UPDATE належить до оператора, а не до вкладеної таблиці"

#: src/engine/core/query/queryParser.cpp:651
msgid "TOTALS belongs to a statement's result, not to a nested table"
msgstr "TOTALS належить до результату оператора, а не до вкладеної таблиці"

#: src/engine/core/query/queryParser.cpp:653
msgid "ORDER BY belongs to a statement, not to a nested table"
msgstr "ORDER BY належить до оператора, а не до вкладеної таблиці"

#: src/engine/core/query/queryParser.cpp:852
