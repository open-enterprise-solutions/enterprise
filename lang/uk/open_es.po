#: src/engine/frmserver/visualView/ctrl/formCommand.h:96
#: src/engine/frmserver/visualView/ctrl/notebook.h:136
#: src/engine/frmserver/visualView/ctrl/widgets.h:74
#: src/engine/frmserver/visualView/layers/commandBar.h:153
msgid "Picture"
msgstr "Картинка"

#: src/engine/backend/metaCollection/metaCommandGroupObject.h:102
msgid "The icon beside the group's caption: at its heading on a section page, and on its button on a form command bar. Empty: caption only."
msgstr "Значок біля заголовка групи: біля її заголовка на сторінці розділу і на її кнопці на командній панелі форми. Порожньо: лише заголовок."

#: src/engine/backend/metaCollection/metaCommandGroupObject.h:103
#: src/engine/backend/metaCollection/metaCommandObject.h:157
#: src/engine/deskgui/univ/propgrid/advprops.cpp:790
#: src/engine/frmserver/visualView/ctrl/sizer.h:190
#: src/engine/frmserver/visualView/ctrl/window.h:36
#: src/engine/frmserver/visualView/layers/commandBar.h:155
msgid "Tooltip"
msgstr "Підказка"

#: src/engine/backend/metaCollection/metaCommandGroupObject.h:104
msgid "The hint shown when the pointer rests on the group's heading or on its button, one text per language. Empty: the synonym is shown."
msgstr "Підказка, що показується, коли вказівник затримується на заголовку групи або на її кнопці, свій текст для кожної мови. Порожньо: показується синонім."

#: src/engine/backend/metaCollection/metaCommandObject.h:18
msgid "Important"
msgstr "Важлива"

#: src/engine/backend/metaCollection/metaCommandObject.h:19
