msgstr "Регістр '%s': не вдалося зберегти записи"

#: src/engine/backend/metaCollection/partial/commonObject.cpp:3984
#, c-format
msgid "Register '%s': writing cancelled by the OnWrite handler"
msgstr "Регістр '%s': запис скасовано обробником OnWrite"

#: src/engine/backend/metaCollection/partial/commonObject.cpp:4004
