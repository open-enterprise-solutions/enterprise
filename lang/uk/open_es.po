msgstr "неочікуваний текст після поля рівня"

#: src/engine/core/query/queryParser.cpp:906
msgid "expected an aggregate function (SUM/COUNT/MIN/MAX/AVG) or BY in TOTALS"
msgstr "у TOTALS очікується агрегатна функція (SUM/COUNT/MIN/MAX/AVG) або BY"

#: src/engine/core/query/queryParser.cpp:937
msgid "expected a grouping name after OVER: the level this figure is computed over"
msgstr "після OVER очікується ім'я групування: рівень, за яким обчислюється цей показник"

#: src/engine/core/query/queryParser.cpp:941
msgid "expected a grouping name after the branch name in OVER"
msgstr "в OVER після імені гілки очікується ім'я групування"

