msgid "OVER is the area of the whole TOTALS figure and is written after it: SUM(a) - SUM(b) OVER Level"
msgstr "OVER — область усього показника TOTALS і пишеться після нього: SUM(a) - SUM(b) OVER Рівень"

#: src/engine/core/query/queryParser.cpp:1072
msgid "expected a name"
msgstr "очікується ім'я"

#: src/engine/core/query/queryParser.cpp:1084
msgid "expected a name after '.'"
msgstr "після '.' очікується ім'я"

