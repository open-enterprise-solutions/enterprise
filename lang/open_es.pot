msgid "The column's starting width, in pixels. The user can change it when the column is resizable."
msgstr ""

#: src/engine/frmserver/visualView/ctrl/tableBox.h:869
msgid "How the header text is aligned: left (the default), center or right."
msgstr ""

#: src/engine/frmserver/visualView/ctrl/tableBox.h:870
msgid "Footer align"
msgstr ""

#: src/engine/frmserver/visualView/ctrl/tableBox.h:871
msgid "How the footer text is aligned: left (the default), center or right. Right suits a total under a numeric column."
msgstr ""

#: src/engine/frmserver/visualView/ctrl/tableBox.h:873
msgid "What the header and footer cells show: text, picture, or both. Auto: the title and the picture, whichever are set."
msgstr ""

#: src/engine/frmserver/visualView/ctrl/tableBox.h:875
msgid "Header picture"
msgstr ""

#: src/engine/frmserver/visualView/ctrl/tableBox.h:876
msgid "An icon in the column's header cell, beside or instead of the title (see Representation). A narrow flag column often shows only a picture."
