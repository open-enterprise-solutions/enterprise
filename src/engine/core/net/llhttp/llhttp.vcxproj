    <Import Project="..\..\..\..\..\Common.props" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(oes3rdParty)llhttp\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Common.props asks every project for a precompiled header; these are C files from another tree and
           have none, which is 3 x C1010 ("unexpected end of file while looking for precompiled header"). -->
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level3</WarningLevel>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(oes3rdParty)llhttp\src\llhttp.c" />
    <ClCompile Include="$(oes3rdParty)llhttp\src\http.c" />
