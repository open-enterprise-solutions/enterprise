<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- THE MANIFEST OF EVERY PROGRAM OF THE PLATFORM, merged into the one the linker makes: written for Windows 10 and later,
     and paths past MAX_PATH - a base or a server folder may lie deep. The linker says the rest (asInvoker), and wx the
     common controls of version 6 (its defs.h asks the linker for them in every program with a window). Not said here:
     awareness of each monitor's scale - wx's own default leaves it off, and turning it on changes how every window is
     drawn. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
