  <!--
    Syntax-helper content stage. Pack syntaxHelper\(locale)\*.json into
    $(OutDir)help\(locale).hlk (zip, DEFLATE) so the runtime locator
    finds one file per locale next to the exe in production. Source-of-
    truth is $(SolutionDir)syntaxHelper; dev runs read from there
    directly via the walk-up fallback in ibHelpService::ResolvePlatformDir
    (loader's ResolveSource picks zip when present, dir otherwise).

    PowerShell Compress-Archive is preferred over tar.exe because tar
    with the "-C dir ." form prefixes every entry with "./", which the
    wxZipInputStream-side parser handles non-trivially (asserts on
    debug builds for the bare "./" dir marker). Compress-Archive
    writes entries as bare leaf names without that prefix and without
    a directory entry. -Force overwrites; the .pack-stamp.txt sentinel
    drives MSBuild Inputs/Outputs so the Target re-runs only when
    source JSON or build-tree state changed.
  -->
  <Target Name="StageSyntaxHelperContent" AfterTargets="Build"
          Inputs="$(SolutionDir)syntaxHelper\**\*.json"
          Outputs="$(OutDir)help\.pack-stamp.txt">
    <MakeDir Directories="$(OutDir)help" />
    <ItemGroup>
      <SyntaxHelperLocales Include="$([System.IO.Directory]::GetDirectories('$(SolutionDir)syntaxHelper'))" />
    </ItemGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Add-Type -A 'System.IO.Compression.FileSystem'; if (Test-Path '$(OutDir)help\%(SyntaxHelperLocales.Filename).hlk') { Remove-Item '$(OutDir)help\%(SyntaxHelperLocales.Filename).hlk' -Force }; [IO.Compression.ZipFile]::CreateFromDirectory('%(SyntaxHelperLocales.FullPath)', '$(OutDir)help\%(SyntaxHelperLocales.Filename).hlk', 'Optimal', 0)&quot;"
          WorkingDirectory="$(SolutionDir)" />
    <Touch Files="$(OutDir)help\.pack-stamp.txt" AlwaysCreate="true" />
  </Target>
