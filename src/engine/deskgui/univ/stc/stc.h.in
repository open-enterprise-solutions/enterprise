// FORKED from wxWidgets' wxStyledTextCtrl (src/stc of wx 3.3; wx -> ib prefixes applied mechanically to the
// names it defines): the host of the Scintilla editing component, a control of the theme engine (ibControl).
// Scintilla and Lexilla are in src/3rdparty, a release copy and a submodule (docs/private/wx-fork.md §2.4).

////////////////////////////////////////////////////////////////////////////
// Name:        wx/stc/stc.h
// Purpose:     A wxWidgets implementation of Scintilla.  This class is the
//              one meant to be used directly by wx applications.  It does not
//              derive directly from the Scintilla classes, and in fact there
//              is no mention of Scintilla classes at all in this header.
//              This class delegates all method calls and events to the
//              Scintilla objects and so forth.  This allows the use of
//              Scintilla without polluting the namespace with all the
//              classes and identifiers from Scintilla.
//
// Author:      Robin Dunn
//
// Created:     13-Jan-2000
// Copyright:   (c) 2000 by Total Control Software
// Licence:     wxWindows licence
/////////////////////////////////////////////////////////////////////////////

/*
    IMPORTANT: stc.h is generated by gen_iface.py from stc.h.in (both beside
               it: `py -3.9 gen_iface.py` in this folder), don't edit stc.h
               file as your changes will be lost after the next regeneration,
               edit stc.h.in and rerun the gen_iface.py script instead!

               Parts of this file generated by the script are found in between
               the special "{{{" and "}}}" markers, the rest of it is copied
               verbatim from src.h.in.
 */

#ifndef _DESKGUI_UNIV_STC_H_
#define _DESKGUI_UNIV_STC_H_

#include "deskgui/deskgui.h"

#include "wx/defs.h"

#if wxUSE_STC

#include "deskgui/univ/ctrl/control.h"
#include "wx/dnd.h"
#include "wx/stopwatch.h"
#include "wx/versioninfo.h"

#include "wx/textentry.h"
#if wxUSE_TEXTCTRL
    #include "wx/textctrl.h"
#endif // wxUSE_TEXTCTRL

class ibScrollBar;

// SWIG can't handle "#if" type of conditionals, only "#ifdef"
#ifdef SWIG
#define STC_USE_DND 1
#else
#if wxUSE_DRAG_AND_DROP
#define STC_USE_DND 1
#endif
#endif

//----------------------------------------------------------------------
// STC constants generated section {{{

%(VALUES)s

//}}}
//----------------------------------------------------------------------


#if defined(__clang__) || defined(__GNUC__)
    #define ibSTC_STRINGIFY(X) #X
    #define ibSTC_DEPRECATED_MACRO_VALUE(value,msg) \
        _Pragma(ibSTC_STRINGIFY(GCC warning msg)) value
#else
    #define ibSTC_DEPRECATED_MACRO_VALUE(value,msg) value
#endif

#if WXWIN_COMPATIBILITY_3_0

// The ibSTC_INDIC{0,1,2,S}_MASK values are no longer used in Scintilla

#if defined(__VISUALC__)
    #pragma deprecated(ibSTC_INDIC0_MASK, ibSTC_INDIC1_MASK, \
                       ibSTC_INDIC2_MASK, ibSTC_INDICS_MASK)
#endif

#define ibSTC_INDIC0_MASK ibSTC_DEPRECATED_MACRO_VALUE(0x20,\
    "ibSTC_INDIC0_MASK is deprecated. Style byte indicators are no longer used.")
#define ibSTC_INDIC1_MASK ibSTC_DEPRECATED_MACRO_VALUE(0x40,\
    "ibSTC_INDIC1_MASK is deprecated. Style byte indicators are no longer used.")
#define ibSTC_INDIC2_MASK ibSTC_DEPRECATED_MACRO_VALUE(0x80,\
    "ibSTC_INDIC2_MASK is deprecated. Style byte indicators are no longer used.")
#define ibSTC_INDICS_MASK ibSTC_DEPRECATED_MACRO_VALUE(0xE0,\
    "ibSTC_INDICS_MASK is deprecated. Style byte indicators are no longer used.")


// The following entries have non-conformant prefixes.

#if defined(__VISUALC__)
    #pragma deprecated(ibSTC_SCMOD_NORM, ibSTC_SCMOD_SHIFT, ibSTC_SCMOD_CTRL, \
                       ibSTC_SCMOD_ALT, ibSTC_SCMOD_SUPER, ibSTC_SCMOD_META, \
                       ibSTC_SCVS_NONE, ibSTC_SCVS_RECTANGULARSELECTION, \
                       ibSTC_SCVS_USERACCESSIBLE, ibSTC_SCVS_NOWRAPLINESTART)
#endif

#define ibSTC_SCMOD_NORM ibSTC_DEPRECATED_MACRO_VALUE(0,\
    "ibSTC_SCMOD_NORM is deprecated. Use ibSTC_KEYMOD_NORM instead.")
#define ibSTC_SCMOD_SHIFT ibSTC_DEPRECATED_MACRO_VALUE(1,\
    "ibSTC_SCMOD_SHIFT is deprecated. Use ibSTC_KEYMOD_SHIFT instead.")
#define ibSTC_SCMOD_CTRL ibSTC_DEPRECATED_MACRO_VALUE(2,\
    "ibSTC_SCMOD_CTRL is deprecated. Use ibSTC_KEYMOD_CTRL instead.")
#define ibSTC_SCMOD_ALT ibSTC_DEPRECATED_MACRO_VALUE(4,\
    "ibSTC_SCMOD_ALT is deprecated. Use ibSTC_KEYMOD_ALT instead.")
#define ibSTC_SCMOD_SUPER ibSTC_DEPRECATED_MACRO_VALUE(8,\
    "ibSTC_SCMOD_SUPER is deprecated. Use ibSTC_KEYMOD_SUPER instead.")
#define ibSTC_SCMOD_META ibSTC_DEPRECATED_MACRO_VALUE(16,\
    "ibSTC_SCMOD_META is deprecated. Use ibSTC_KEYMOD_META instead.")

#define ibSTC_SCVS_NONE ibSTC_DEPRECATED_MACRO_VALUE(0, \
    "ibSTC_SCVS_NONE is deprecated. Use ibSTC_VS_NONE instead.")
#define ibSTC_SCVS_RECTANGULARSELECTION ibSTC_DEPRECATED_MACRO_VALUE(1, \
