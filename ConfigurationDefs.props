<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <!-- Which database drivers are IN this build. The .sln compiles all of them
       unconditionally (there is no per-driver project here), so all four are on.
       CMake sets the same macros from its OES_USE_* options, which makes the rule
       one and the same on both build systems: the macro is defined exactly when the
       driver's sources are compiled. Code that names a driver type must be guarded
       by its macro — appData.cpp names Firebird and PostgreSQL, and without this a
       CMake build with a driver switched OFF still referenced it and failed to link
       (caught by CI on 2026-08-02, the Windows job with PostgreSQL off). -->
  <PropertyGroup>
    <OesDriverDefines>OES_USE_FIREBIRD;OES_USE_POSTGRESQL;OES_USE_ODBC;</OesDriverDefines>
    <!-- cpp-httplib, for every project that includes it, as the root CMakeLists.txt says it for every
         target: the client does not add `Expect: 100-continue` to a large body by itself. -->
    <OesHttpDefines>CPPHTTPLIB_EXPECT_100_THRESHOLD=0;</OesHttpDefines>
    <!-- TLS, for every project, and for Mbed TLS itself. Both have to be said once for the whole program:
         the first because cpp-httplib's inline functions change shape with it and three translation units
         include the header, the second because MBEDTLS_THREADING_C adds a mutex to contexts the callers
         declare - a caller that misses it disagrees with the library about their size. The angle form is
         read from the include path (the project and the callers both carry src\engine\backend\tls), which
         keeps a file path with quotes in it out of a preprocessor definition. -->
    <OesTlsDefines>CPPHTTPLIB_MBEDTLS_SUPPORT;MBEDTLS_USER_CONFIG_FILE=&lt;oes_mbedtls_config.h&gt;;</OesTlsDefines>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>DEBUG;$(OesDriverDefines)$(OesHttpDefines)$(OesTlsDefines)%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug_Dedicated'">
    <ClCompile>
      <PreprocessorDefinitions>DEBUG;$(OesDriverDefines)$(OesHttpDefines)$(OesTlsDefines)%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Mixed'">
    <ClCompile>
      <PreprocessorDefinitions>DEBUG;MIXED;$(OesDriverDefines)$(OesHttpDefines)$(OesTlsDefines)%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Mixed_Dedicated'">
    <ClCompile>
      <PreprocessorDefinitions>DEBUG;MIXED;$(OesDriverDefines)$(OesHttpDefines)$(OesTlsDefines)%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;$(OesDriverDefines)$(OesHttpDefines)$(OesTlsDefines)%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release_Dedicated'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;$(OesDriverDefines)$(OesHttpDefines)$(OesTlsDefines)%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>