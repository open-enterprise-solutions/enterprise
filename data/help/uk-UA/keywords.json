      ]
    },
    {
      "id": "kw.Do",
      "name_local": "Do",
      "name_en": "Do",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Відкриває тіло циклу While або For.",
      "syntax_block": "While <Cond> Do … EndDo;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
