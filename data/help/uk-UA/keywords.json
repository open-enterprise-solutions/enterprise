      "name_en": "In",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Позначає колекцію-джерело в циклі For Each.",
      "syntax_block": "For Each <Item> In <Collection> Do … EndDo;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.For",
        "kw.Foreach"
      ],
      "reviewed": true,
      "modes": [
        "ves",
