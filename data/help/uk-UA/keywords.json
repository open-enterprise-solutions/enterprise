  "locale": "uk-UA",
  "entries": [
    {
      "id": "kw.If",
      "name_local": "Якщо",
      "name_en": "If",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "Якщо <Вираз> Тоді ... [ІнакшеЯкщо ... Тоді ...] [Інакше ...] КінецьЯкщо",
      "description": "Умовне виконання.\n\nОбчислює логічний вираз; за значення Істина виконує гілку Тоді, інакше — необов'язкову гілку ІнакшеЯкщо з власним виразом, інакше — необов'язкову гілку Інакше.",
      "syntax_block": "Якщо <Вираз1> Тоді\n    // оператори\nІнакшеЯкщо <Вираз2> Тоді\n    // оператори\nІнакше\n    // оператори\nКінецьЯкщо",
      "parameters": "<Вираз1>, <Вираз2> — логічні вирази.",
      "return_descr": "",
      "example": "Якщо userInfo.IsAdmin Тоді\n    EnableAdminMenu();\nІнакше\n    HideAdminMenu();\nКінецьЯкщо",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.While"
      ],
      "reviewed": true
    },
    {
      "id": "kw.Then",
      "name_local": "Тоді",
      "name_en": "Then",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Завершує умову гілки Якщо / ІнакшеЯкщо. Тіло за Тоді виконується лише за істинної умови.",
      "syntax_block": "Якщо <Вираз> Тоді\n    // тіло\nКінецьЯкщо;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.If",
        "kw.Else",
        "kw.Elseif",
        "kw.Endif"
      ],
      "reviewed": true
    },
    {
      "id": "kw.Else",
      "name_local": "Інакше",
      "name_en": "Else",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Гілка, що виконується, коли всі умови Якщо / ІнакшеЯкщо виявилися хибними.",
      "syntax_block": "Якщо <Вираз> Тоді\n    // збіг\nІнакше\n    // запасний шлях\nКінецьЯкщо;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.If",
        "kw.Elseif",
        "kw.Endif"
      ],
      "reviewed": true
    },
    {
      "id": "kw.Elseif",
      "name_local": "ІнакшеЯкщо",
      "name_en": "Elseif",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Додає ланцюгову умову до Якщо. Перевіряється, лише якщо кожна попередня гілка дала Хибність.",
      "syntax_block": "Якщо A Тоді\n    // …\nІнакшеЯкщо B Тоді\n    // …\nКінецьЯкщо;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.If",
        "kw.Else",
        "kw.Endif"
      ],
      "reviewed": true
    },
    {
      "id": "kw.Endif",
      "name_local": "КінецьЯкщо",
      "name_en": "Endif",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Закриває конструкцію Якщо.",
      "syntax_block": "Якщо <Вираз> Тоді\n    // тіло\nКінецьЯкщо;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.If"
      ],
      "reviewed": true
    },
    {
      "id": "kw.For",
      "name_local": "Для",
      "name_en": "For",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Лічильниковий або ітераторний цикл. Дві форми: індексна (Для <i> = <від> По <до> Цикл) та поелементна (Для Кожного <Елемент> З <Колекція> Цикл).",
      "syntax_block": "// індексна\nДля i = 1 По 10 Цикл\n    // тіло\nКінецьЦиклу;\n\n// поелементна\nДля Кожного Елемент З Колекція Цикл\n    // тіло\nКінецьЦиклу;",
      "parameters": "",
      "return_descr": "",
      "example": "Для Кожного Замовлення З Клієнт.Замовлення Цикл\n    Підсумок = Підсумок + Замовлення.Сума;\nКінецьЦиклу;",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.While",
        "kw.Foreach",
        "kw.In",
        "kw.To",
        "kw.Do",
        "kw.EndDo",
        "kw.Break",
        "kw.Continue"
      ],
      "reviewed": true
    },
    {
