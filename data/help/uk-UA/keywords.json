    {
      "id": "kw.Continue",
      "name_local": "Continue",
      "name_en": "Continue",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Пропускає решту поточної ітерації; керування переходить на заголовок циклу.",
      "syntax_block": "For Each Row In Table Do\n    If Row.IsHeader Then Continue; EndIf;\n    Process(Row);\nEndDo;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.For",
        "kw.While",
        "kw.Break"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Break",
      "name_local": "Break",
      "name_en": "Break",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Перериває найближчий охоплюючий цикл; керування переходить за EndDo.",
      "syntax_block": "While Cond Do\n    If StopCondition Then Break; EndIf;\n    // …\nEndDo;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
