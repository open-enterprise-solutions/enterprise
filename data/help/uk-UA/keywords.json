      "modes": [
        "ves"
      ]
    },
    {
      "id": "kw.EndDo",
      "name_local": "EndDo",
      "name_en": "EndDo",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Закриває тіло циклу While або For.",
      "syntax_block": "While X Do\n    // …\nEndDo;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.While",
        "kw.For",
        "kw.Do"
      ],
      "reviewed": true,
      "modes": [
        "ves"
      ]
    },
    {
      "id": "kw.While",
      "name_local": "While",
      "name_en": "While",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Цикл з передумовою. Перед кожною ітерацією перевіряє умову; виконує тіло, поки умова істинна.",
      "syntax_block": "while (<Condition>) {\n    // body\n}",
      "parameters": "",
      "return_descr": "",
      "example": "Counter = 0;\nwhile (Counter < 10) {\n    Counter = Counter + 1;\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.For",
        "kw.Break",
        "kw.Continue"
      ],
      "reviewed": true,
      "syntax_block_ves": "While <Condition> Do\n    // body\nEndDo;",
      "example_ves": "Counter = 0;\nWhile Counter < 10 Do\n    Counter = Counter + 1;\nEndDo;",
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.GoTo",
      "name_local": "GoTo",
      "name_en": "GoTo",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Безумовний перехід до позначеного оператора в межах того ж блоку. Використовуйте помірно — майже завжди чистіше переписати через цикл або функцію.",
      "syntax_block": "GoTo ~<Label>;\n…\n~<Label>:",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Not",
      "name_local": "Not",
      "name_en": "Not",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Логічне заперечення.",
      "syntax_block": "Not <Expression>",
      "parameters": "",
      "return_descr": "",
      "example": "If Not User.IsLoggedIn Then\n    ShowLoginForm();\nEndIf;",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.And",
        "kw.Or"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.And",
      "name_local": "And",
      "name_en": "And",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Логічне І. Коротке замикання: правий операнд не обчислюється, якщо лівий — False.",
      "syntax_block": "<LeftExpr> And <RightExpr>",
      "parameters": "",
      "return_descr": "",
      "example": "If User.IsLoggedIn And User.Role = \"admin\" Then\n    ShowAdminPanel();\nEndIf;",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Or",
        "kw.Not"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Or",
      "name_local": "Or",
      "name_en": "Or",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Логічне АБО. Коротке замикання: правий операнд не обчислюється, якщо лівий — True.",
      "syntax_block": "<LeftExpr> Or <RightExpr>",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.And",
        "kw.Not"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Procedure",
      "name_local": "Procedure",
      "name_en": "Procedure",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Оголошує процедуру — викликаний блок коду, що виконує дії, але не повертає значення. Якщо викликачу потрібен результат — використовуйте Function.",
      "syntax_block": "Procedure <Name>([Val] <Param1>, [Val] <Param2>, …) [Export] {\n    // body\n}",
      "parameters": "<Name> — ідентифікатор. Val — модифікатор «за значенням». Export — робить процедуру доступною з інших модулів.",
      "return_descr": "",
      "example": "Procedure LogMessage(Val Text) Export {\n    Message(Text);\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Function",
        "kw.Return",
        "kw.Export",
        "kw.Val"
      ],
      "reviewed": true,
      "syntax_block_ves": "Procedure <Name>([Val] <Param1>, [Val] <Param2>, …) [Export]\n    // body\nEndProcedure",
      "example_ves": "Procedure LogMessage(Val Text) Export\n    Message(Text);\nEndProcedure",
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.EndProcedure",
      "name_local": "EndProcedure",
      "name_en": "EndProcedure",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Закриває тіло процедури. Керування повертається викликачу при досягненні EndProcedure.",
      "syntax_block": "Procedure Demo()\n    // …\nEndProcedure",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Procedure"
      ],
      "reviewed": true,
      "modes": [
        "ves"
      ]
    },
    {
      "id": "kw.Function",
      "name_local": "Function",
      "name_en": "Function",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Оголошує функцію — викликаний блок коду, що повертає значення через Return. Функції взаємозамінні з процедурами скрізь, окрім використання як джерело виразу.",
      "syntax_block": "Function <Name>([Val] <Param1>, …) [Export] {\n    // body\n    Return <Value>;\n}",
      "parameters": "<Name> — ідентифікатор. Val — модифікатор «за значенням». Export — робить функцію доступною з інших модулів.",
      "return_descr": "Значення, передане оператору Return.",
      "example": "Function Sum(Val A, Val B) Export {\n    Return A + B;\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Procedure",
        "kw.Return",
        "kw.Export"
      ],
      "reviewed": true,
      "syntax_block_ves": "Function <Name>([Val] <Param1>, …) [Export]\n    // body\n    Return <Value>;\nEndFunction",
      "example_ves": "Function Sum(Val A, Val B) Export\n    Return A + B;\nEndFunction",
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.EndFunction",
      "name_local": "EndFunction",
      "name_en": "EndFunction",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Закриває тіло функції. Досягнення EndFunction без оператора Return дає Undefined.",
      "syntax_block": "Function Demo()\n    Return 42;\nEndFunction",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Function",
        "kw.Return",
        "kw.Undefined"
      ],
      "reviewed": true,
      "modes": [
        "ves"
      ]
    },
    {
      "id": "kw.Export",
      "name_local": "Export",
      "name_en": "Export",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Позначає процедуру, функцію або модульну змінну доступною з інших модулів. Без Export символ видно лише у своєму модулі.",
      "syntax_block": "Procedure DoWork() Export\n    // body\nEndProcedure",
      "parameters": "",
      "return_descr": "",
      "example": "Var Counter Export;  // module-public variable\n\nFunction Read() Export\n    Return Counter;\nEndFunction",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Procedure",
        "kw.Function",
        "kw.Var"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Val",
      "name_local": "Val",
      "name_en": "Val",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Модифікатор параметра «за значенням». Без Val параметр звʼязаний за посиланням, і присвоєння всередині викликаного коду змінюють змінну викликача; зі Val береться локальна копія.",
      "syntax_block": "Procedure Demo(Val ReadOnlyParam, MutableParam)\n    // ReadOnlyParam is a copy of the caller's value.\n    // MutableParam writes back into the caller's variable.\nEndProcedure",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Procedure",
        "kw.Function"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Return",
      "name_local": "Return",
      "name_en": "Return",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Виходить з поточної процедури або функції. Усередині функції може містити вираз-результат.",
      "syntax_block": "Return;                 // exit procedure\nReturn <Expression>;    // exit function with result",
      "parameters": "",
      "return_descr": "",
      "example": "Function Sign(Val X)\n    If X < 0 Then Return -1; EndIf;\n    If X > 0 Then Return 1;  EndIf;\n    Return 0;\nEndFunction",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Function",
        "kw.Procedure"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Try",
      "name_local": "Try",
      "name_en": "Try",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Починає блок обробки виключень. Код всередині відстежується; виникле виключення передає керування в гілку Except.",
      "syntax_block": "try {\n    // protected body\n} except {\n    // handler — runs on any raised exception\n}",
      "parameters": "",
      "return_descr": "",
      "example": "try {\n    Result = ParseNumber(UserInput);\n} except {\n    Message(\"Not a valid number: \" + ErrorDescription());\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Except",
        "kw.Raise"
      ],
      "reviewed": true,
      "syntax_block_ves": "Try\n    // protected body\nExcept\n    // handler — runs on any raised exception\nEndTry;",
      "example_ves": "Try\n    Result = ParseNumber(UserInput);\nExcept\n    Message(\"Not a valid number: \" + ErrorDescription());\nEndTry;",
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Except",
      "name_local": "Except",
      "name_en": "Except",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Відкриває гілку обробника конструкції Try / Except. Виконується, якщо захищений блок породив виключення.",
      "syntax_block": "Try\n    // …\nExcept\n    // recovery\nEndTry;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Try",
        "kw.Endtry",
        "kw.Raise"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Endtry",
      "name_local": "Endtry",
      "name_en": "Endtry",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
