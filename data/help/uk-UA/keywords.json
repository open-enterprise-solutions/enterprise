    {
      "id": "kw.While",
      "name_local": "Поки",
      "name_en": "While",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Цикл з передумовою. Перед кожною ітерацією перевіряє умову; виконує тіло, поки умова істинна.",
      "syntax_block": "Поки <Умова> Цикл\n    // тіло\nКінецьЦиклу;",
      "parameters": "",
      "return_descr": "",
      "example": "Лічильник = 0;\nПоки Лічильник < 10 Цикл\n    Лічильник = Лічильник + 1;\nКінецьЦиклу;",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.For",
        "kw.Do",
        "kw.EndDo",
        "kw.Break",
        "kw.Continue"
      ],
      "reviewed": true
    },
    {
