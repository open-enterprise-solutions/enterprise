    {
      "id": "kw.EndDo",
      "name_local": "КінецьЦиклу",
      "name_en": "EndDo",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Закриває тіло циклу Поки або Для.",
      "syntax_block": "Поки X Цикл\n    // …\nКінецьЦиклу;",
      "parameters": "",
      "return_descr": "",
