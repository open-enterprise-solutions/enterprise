#: src/engine/backend/metaCollection/partial/commonObject.h:758
msgid "Quick choice"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:758
msgid "How an input field of this type is filled. On: typing in the field offers a drop-down of the matching items, and the item is picked there - meant for short lists of a few dozen items. Off (the default): the field opens the list form to choose from."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:759
msgid "The reference to the object - its identity. Every link to it from other objects, tabular sections and registers stores this value; it never changes, whatever is renamed or edited in the object."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:906
#: src/engine/frontend/win/dlgs/linqConstructor/linqConstructor.cpp:438
#: src/engine/frontend/win/dlgs/linqConstructor/linqConstructor.cpp:442
#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructor.cpp:501
#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorInternal.h:107
msgid "Order"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:906
msgid "The position of the value in its enumeration, as the values are listed in the configuration. Values compare and sort by it, so a query ordering by an enumeration field orders by the declared order, not by the name."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:923
msgctxt "access right"
msgid "Delete"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1073
msgid "List generation"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1073
msgid "The kinds of objects that can be created on the basis of this one. The Generate command of its form offers exactly these; the new object is filled from this one by its own filling handler. Empty: nothing is created from it."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1074
msgid "Data version"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1074
msgid "A stamp the platform changes on every write of the object. A write locks the stored row and compares the stamp with the one read: if somebody else wrote the object in between, the write is refused rather than overwriting their change."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1075
msgid "Deletion mark"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1075
msgid "Set when the object is marked for deletion: it stays in the base with every link to it and is shown crossed out; deleting it is a separate step. A posted document has its posting undone when it is marked."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1238
msgid "from"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1276
msgid "List register record"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1276
msgid "The registers this document writes its movements to. For each one the document gets a record set (RegisterRecords.<Register>) addressed by its reference, filled by the posting handler and written when posting ends; a register not listed here cannot take this document as its recorder."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1279
msgid "List sequence record"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1279
msgid "The sequences this document registers in. For each one the document gets a set of registrations (Sequences.<Sequence>) addressed by its reference, filled by the posting handler and written when posting ends; the sequence's border then moves by those rows. A sequence not listed here cannot take this document as its recorder."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1284
msgid "Register records deletion"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1284
msgid "What the platform does with the document's movements when it is posted again or its posting is undone. Automatically (the default): cleared before the posting handler runs and when the posting is undone. On undo posting: kept when posted again, cleared on undo. Never: the configuration clears them. A deleted document always takes its movements with it."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1285
msgctxt "document attribute"
msgid "Number"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1285
msgid "The document's number - what a person finds it by. Indexed; shown with the date in lists and links. Left empty, it is generated when the document is written; the object module's SetNewNumber handler may give it a prefix or take the numbering over."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1286
#: src/engine/backend/system/value/valueType.cpp:480
#: src/engine/designer/mainFrame/vcs/gitPanel.cpp:68
#: src/engine/frontend/propertyManager/property/advprop/advpropType.cpp:36
#: src/engine/frontend/win/dlgs/formatConstructor/formatConstructor.cpp:24
#: src/engine/frontend/win/dlgs/formatConstructor/formatConstructor.cpp:283
#: src/engine/frontend/win/dlgs/typeSelector.cpp:176
msgid "Date"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1286
msgid "The document's date and time - when the fact happened. Documents are ordered by it, and it is the moment its movements stand at in the registers: a balance as of a moment counts the documents up to it."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1289
#: src/engine/backend/metaCollection/partial/sequence.h:323
msgid "Point in time"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1289
msgid "The document's moment: its date together with the document itself, so two documents of the same second are still ordered. Not stored - built from the date and the reference; passed to a register's virtual table it reads everything up to (or before) this very document."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1651
#: src/engine/frontend/win/ctrls/tableView.cpp:35
msgid "Hierarchy"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1652
msgid "Hierarchy type"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1652
msgid "How the values are arranged. Folders (the default): folders hold items and other folders, and the list walks them as a tree. Items: every value is an item, and any item may stand under another (a chart of accounts) - the same tree without folders. No hierarchy: no parent at all. It decides what Parent may point to and whether IsFolder exists."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1655
msgid "Data presentation"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1655
msgid "How a reference to an item reads wherever it is shown - in a field, a list, a report: by its Description (the default for a catalog) or by its Code (the default for a chart of accounts, whose accounts are named by their numbers)."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1658
msgid "Predefined name"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1658
msgid "The name of an item the configuration itself declares (a predefined item) - what code refers to it by, as Catalogs.<Name>.<PredefinedName>. Empty for items created by users; a predefined item cannot be deleted."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1659
msgid "The item's code - a short identifier a person types or searches by. Indexed. Left empty, it is generated when the item is written; the object module's SetNewCode handler may give it a prefix or take the numbering over."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1660
#: src/engine/backend/metaCollection/partial/commonObjectEnum.h:57
#: src/engine/designer/win/dlg/predefinedEditor.cpp:109
#: src/engine/designer/win/dlg/predefinedEditor.h:217
msgctxt "item name"
msgid "Description"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1660
msgid "The item's name - what it is shown as wherever a reference to it appears: in fields, lists, reports and printed forms. Indexed, and searched by in quick choice."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1661
#: src/engine/designer/win/dlg/predefinedEditor.h:177
msgid "Parent"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1661
msgid "The folder or item this one sits under. What it may point to follows the hierarchy type: a folder in a folders-and-items hierarchy, any item in an items hierarchy. Empty: the item is at the top level."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1662
msgid "Is folder"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:1662
msgid "Set on a folder of a folders-and-items hierarchy: a folder only holds other items and folders, and carries only the attributes whose use says folders. Decided when the object is created and not changed afterwards."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:2008
msgid "Whether the register record counts. An inactive record stays in the register but is left out of every total, balance, slice and reading, as if it were not there."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:2009
#: src/engine/frontend/win/dlgs/settings/composer/composerSettings.cpp:308
msgid "Period"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:2009
msgid "The moment the record belongs to: the date of its recorder for a register written by documents, the date of the value for a periodic information register. Totals, balances and slices are read as of it."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:2010
msgid "Recorder"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:2010
msgid "The document the record was written by. A register subordinate to recorders is written and cleared by recorder: the document's record set holds exactly its own records, and posting it again replaces them."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:2011
msgid "Line number"
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:2011
msgid "The record's number inside its recorder's record set, from 1, in the order the lines were added. With the recorder it identifies a record."
msgstr ""

#: src/engine/backend/metaCollection/partial/commonObject.h:2435
#: src/engine/backend/metaCollection/partial/commonObject.h:2661
#: src/engine/backend/metaCollection/partial/commonObject.h:3360
msgid "Creating"
msgstr ""

