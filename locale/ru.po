msgid "Posting"
msgstr "Проведение"

#: src/engine/backend/metaCollection/partial/documentEnum.h:35
msgid "Undo posting"
msgstr "Отмена проведения"

#: src/engine/backend/metaCollection/partial/documentEnum.h:45
msgid "Real time"
msgstr "Оперативный"

#: src/engine/backend/metaCollection/partial/documentEnum.h:46
msgid "Regular"
msgstr "Неоперативный"

#: src/engine/backend/metaCollection/partial/documentEnum.h:54
msgid "Delete automatically"
msgstr "Удалять автоматически"

#: src/engine/backend/metaCollection/partial/documentEnum.h:55
