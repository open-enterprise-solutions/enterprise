msgstr "ORDER BY по выражению над вычисляемым источником пока не поддерживается: сортируйте по колонке"

#: src/engine/backend/query/queryLowering.cpp:4127
#, c-format
msgid "ORDER BY %s: select it, and sort by its name"
msgstr "ORDER BY %s: выберите его и сортируйте по его имени"

#: src/engine/backend/query/queryLowering.cpp:4175
#, c-format
msgid "ORDER BY '%s' needs that path among the GROUP BY keys - a grouped query can only sort by what it grouped by. Add it to GROUP BY, or sort by one of the keys."
msgstr "ORDER BY '%s' требует, чтобы этот путь был среди ключей GROUP BY - сгруппированный запрос может сортировать только по тому, по чему группировал. Добавьте его в GROUP BY или сортируйте по одному из ключей."

#: src/engine/backend/query/queryLowering.cpp:4211
msgid "ORDER BY an aggregate sorts by one this query SELECTS - add it to the selection (SUM(x) AS Total) and sort by that name"
msgstr "ORDER BY по агрегату сортирует по агрегату, который этот запрос ВЫБИРАЕТ - добавьте его в выборку (SUM(x) AS Total) и сортируйте по этому имени"

#: src/engine/backend/query/queryLowering.cpp:4356
#, c-format
msgid "UNION branch %d selects %u column(s) while the first selects %u - every branch of a union must select the same columns, in the same order"
msgstr "ветвь UNION %d выбирает колонок: %u, а первая - %u - каждая ветвь объединения должна выбирать одни и те же колонки в том же порядке"

#: src/engine/backend/query/queryLowering.cpp:4472
msgid "a subquery / UNION branch may not use TOTALS yet"
msgstr "подзапрос / ветвь UNION пока не может использовать TOTALS"

#: src/engine/backend/query/queryLowering.cpp:4590
msgid "FOR UPDATE cannot stand beside TOTALS: lock the rows with a plain query first, then total them"
msgstr "FOR UPDATE не может стоять рядом с TOTALS: сначала заблокируйте строки простым запросом, затем подведите по ним итоги"

#: src/engine/backend/query/queryLowering.cpp:4700
msgid "TOTALS and ORDER BY over SELECT * or SELECT DISTINCT may name only the fields the query selects"
msgstr "TOTALS и ORDER BY над SELECT * или SELECT DISTINCT могут указывать только поля, которые выбирает запрос"

#: src/engine/backend/query/queryLowering.cpp:5170
msgid "FOR UPDATE cannot be used with UNION: a composed result holds no rows to lock"
msgstr "FOR UPDATE нельзя использовать с UNION: в составном результате нет строк, которые можно заблокировать"

#: src/engine/backend/query/queryLowering.cpp:5288
msgid "a reference-path JOIN (alias.field) needs an explicit alias (AS)"
msgstr "JOIN по пути ссылки (alias.field) требует явного псевдонима (AS)"

#: src/engine/backend/query/queryLowering.cpp:5394
msgid "an outer JOIN ON takes a key of column comparisons (a.x = b.y AND a.z = b.w). A term that filters ONE side cannot ride with it, and moving that term to WHERE is NOT the same query - it drops the null-padded rows and makes the join inner. Put it inside the joined source instead (a subquery, or a virtual table's own parameters), or make the join inner if that is what was meant"
msgstr "внешний JOIN ON принимает ключ из сравнений колонок (a.x = b.y AND a.z = b.w). Условие, отбирающее ОДНУ сторону, не может идти вместе с ним, а перенос такого условия в WHERE - это НЕ тот же запрос: он отбрасывает строки, дополненные NULL, и делает соединение внутренним. Поместите его внутрь присоединяемого источника (подзапрос или собственные параметры виртуальной таблицы) или сделайте соединение внутренним, если имелось в виду именно это"

#: src/engine/backend/query/queryLowering.cpp:5409
msgid "a JOIN ON clause must compare two sides (a.x <op> b.y), or be TRUE for a cross join"
msgstr "предложение JOIN ON должно сравнивать две стороны (a.x <op> b.y) или быть TRUE для перекрёстного соединения"

#: src/engine/backend/query/queryLowering.cpp:5432
msgid "a constant JOIN ON (column <op> value/&param) can only be carried on an INNER join. Moving it to WHERE is NOT the same query on an outer join - it drops the null-padded rows and makes the join inner. Either the join is inner, or the condition belongs inside the joined source itself (a subquery, or a virtual table's own parameters)"
msgstr "константное условие JOIN ON (column <op> value/&param) допустимо только во внутреннем (INNER) соединении. Перенос его в WHERE при внешнем соединении - это НЕ тот же запрос: он отбрасывает строки, дополненные NULL, и делает соединение внутренним. Либо соединение внутреннее, либо условию место внутри самого присоединяемого источника (подзапрос или собственные параметры виртуальной таблицы)"

#: src/engine/backend/query/queryLowering.cpp:5629
#, c-format
msgid "Table '%s' does not exist"
msgstr "Таблица '%s' не существует"

