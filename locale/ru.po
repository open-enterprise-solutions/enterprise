msgstr "кодировка задаётся значением TextEncoding - например, TextEncoding.UTF8"

#: src/engine/backend/system/value/valueHttp.cpp:243
#, c-format
msgid "HTTPRequest: a resource address starts with '/' - the host and the port are the connection's: '%s'"
msgstr "HTTPRequest: адрес ресурса начинается с '/' - хост и порт задаются в соединении: '%s'"

#: src/engine/backend/system/value/valueHttp.cpp:245
