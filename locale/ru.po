msgstr "Параметры виртуальной таблицы..."

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:1501
#: src/engine/frontend/win/dlgs/userItem.cpp:83
msgid "Name:"
msgstr "Имя:"

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:1501
msgid "Change table name"
msgstr "Изменить имя таблицы"

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:1521
msgid "table name"
msgstr "имя таблицы"

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:1588
#: src/engine/frontend/win/dlgs/settings/composer/composerSettings.cpp:2512
#: src/engine/frontend/win/dlgs/settings/composer/composerSettings.cpp:4590
msgid "Add table"
msgstr "Добавить таблицу"

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:1602
msgid "Replace table"
msgstr "Заменить таблицу"

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:1687
#, c-format
msgid "This query already has a table called '%s'."
msgstr "В этом запросе уже есть таблица с именем '%s'."

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:1688
#: src/engine/frontend/win/dlgs/queryConstructor/queryTempTableDialog.cpp:91
msgid "Temporary table"
msgstr "Временная таблица"

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:1910
msgid "This table is not a nested one: only a nested table has a query to edit."
msgstr "Эта таблица не вложенная: запрос для редактирования есть только у вложенной таблицы."

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:1911
msgid "Edit nested table"
msgstr "Изменить вложенную таблицу"

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:2131
#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:2198
msgid "Field expression"
msgstr "Выражение поля"

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:2282
msgid "Select a link to copy. It lands on the first table that has none: if every table already carries one, there is nowhere to put it."
msgstr "Выберите связь для копирования. Она попадёт на первую таблицу без связи: если связь уже есть у каждой таблицы, поместить её некуда."

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:2699
msgid "Add a grouping level first, or tick Grand totals: totals are counted PER LEVEL, so there has to be one."
msgstr "Сначала добавьте уровень группировки или отметьте Общие итоги: итоги считаются ПО УРОВНЯМ, поэтому хотя бы один уровень нужен."

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:2783
#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:2841
#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:3257
msgid "Grouping level"
msgstr "Уровень группировки"

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorEdit.cpp:3038
msgid "The last grouping level is gone, so the totals go with it: they are counted PER LEVEL, and there is no level left to count them on."
msgstr "Последний уровень группировки удалён, поэтому итоги удалены вместе с ним: они считаются ПО УРОВНЯМ, а уровней, по которым их считать, не осталось."

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorFill.cpp:81
msgid "Choose a table first: the fields come from the tables the query reads."
msgstr "Сначала выберите таблицу: поля берутся из таблиц, которые читает запрос."

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorFill.cpp:1014
msgid "Temporary tables"
msgstr "Временные таблицы"

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorFill.cpp:1244
msgid "All fields"
msgstr "Все поля"

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorFill.cpp:1672
#, c-format
msgid ""
"'%s' cannot be a %s.\n"
"\n"
"A name is one word: letters, digits and underscores, with no spaces or punctuation."
msgstr ""
"'%s' не подходит как %s.\n"
"\n"
"Имя - это одно слово: буквы, цифры и подчёркивания, без пробелов и знаков препинания."

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorFill.cpp:1697
#, c-format
msgid "the link on '%s' has no condition: write one, or delete the link. Two tables with no link between them are simply multiplied."
msgstr "у связи таблицы '%s' нет условия: задайте его или удалите связь. Две таблицы без связи между ними просто перемножаются."

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorFill.cpp:1746
msgid "The query engine reads this query."
msgstr "Движок запросов читает этот запрос."

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorText.cpp:89
msgid "Query text"
msgstr "Текст запроса"

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorText.cpp:100
#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorText.cpp:175
msgid "Open the selection"
msgstr "Открыть выделенное"

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorText.cpp:152
msgid "No errors found in the selection."
msgstr "В выделенном фрагменте ошибок не обнаружено."

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorText.cpp:164
msgid "No errors found."
msgstr "Ошибок не обнаружено."

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorText.cpp:174
msgid "Select a part of the query text first: that part opens as a query of its own."
msgstr "Сначала выделите часть текста запроса: она откроется как отдельный запрос."

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorText.cpp:261
msgid "Keep this query anyway? The constructor will not open on it again - it will report this error instead, and the query will have to be repaired as text."
msgstr "Всё равно сохранить этот запрос? Конструктор больше не откроется на нём - вместо этого он сообщит об этой ошибке, и запрос придётся исправлять как текст."

#: src/engine/frontend/win/dlgs/queryConstructor/queryConstructorText.cpp:337
msgid "Open the constructor on an empty query? The existing text will be replaced only if you press OK."
msgstr "Открыть конструктор с пустым запросом? Существующий текст будет заменён, только если вы нажмёте OK."

