msgstr "отмечено"

#. TRANSLATORS: Checkbox state name
#: src/engine/frontend/win/ctrls/dataview/datavcmn.cpp:2096
#: src/engine/frontend/win/ctrls/dataview/datavgen.cpp:1396
msgid "unchecked"
msgstr "не отмечено"

#. TRANSLATORS: Checkbox state name
#: src/engine/frontend/win/ctrls/dataview/datavcmn.cpp:2100
msgid "undetermined"
msgstr "не определено"

#. TRANSLATORS: Name of Boolean true value
#: src/engine/frontend/win/ctrls/dataview/datavgen.cpp:1142
