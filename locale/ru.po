msgstr "'%s' - глобальная функция - она не принадлежит этому значению"

#: src/engine/backend/backend_exception.cpp:210
#, c-format
msgid "Nothing can follow a group without a name: its answer is the groups themselves, each with Key and Values. To go on - Select, Where, OrderBy - name the group: '%s <name>'."
msgstr "После группы без имени ничего не может идти: её ответ - сами группы, у каждой Key и Values. Чтобы продолжить - Select, Where, OrderBy - дайте группе имя: '%s <имя>'."

#: src/engine/backend/backend_exception.cpp:692
msgid "Context functions are not available: this is a server, and a server has no forms."
msgstr "Контекстные функции недоступны: это сервер, а у сервера нет форм."

#: src/engine/backend/backend_exception.cpp:694
#, c-format
msgid "Context functions are not available: this is a server, and a server has no forms (asked for %s)."
msgstr "Контекстные функции недоступны: это сервер, а у сервера нет форм (запрошено: %s)."

#: src/engine/backend/backend_exception.cpp:703
#, c-format
