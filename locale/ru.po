msgstr "два оператора этого пакета называют свой результат '%s'"

#: src/engine/backend/query/queryLowering.cpp:6839
#: src/engine/backend/query/queryLowering.cpp:7319
#, c-format
msgid "temporary table '%s' already exists"
msgstr "временная таблица '%s' уже существует"

