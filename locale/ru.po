msgstr "Колонка %u"

#: src/engine/frontend/win/ctrls/dataview/headerctrlcmn.cpp:57
msgid "Please select the columns to show and define their order:"
msgstr "Пожалуйста, выберите столбцы для отображения и определите их порядок:"

#: src/engine/frontend/win/ctrls/dataview/headerctrlcmn.cpp:58
msgid "Customize Columns"
msgstr "Настроить столбцы"

#: src/engine/frontend/win/ctrls/dataview/headerctrlcmn.cpp:304
msgid "&Customize..."
msgstr "&Настроить..."

#: src/engine/frontend/win/ctrls/grid/gridext.cpp:7118
msgid "Copying more than one selected block to clipboard is not supported."
msgstr "Копирование более одного выбранного блока в буфер обмена не поддерживается."

#: src/engine/frontend/win/ctrls/grid/gridext.cpp:11761
#: src/engine/frontend/win/ctrls/grid/gridext.cpp:11795
#: src/engine/frontend/win/ctrls/grid/gridext.cpp:11817
#: src/engine/frontend/win/ctrls/grid/gridext.cpp:11851
