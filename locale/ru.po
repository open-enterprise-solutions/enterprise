msgstr "HTTPRequest: адрес ресурса не может содержать переводы строк и управляющие символы"

#: src/engine/backend/system/value/valueHttp.cpp:247
#, c-format
msgid "HTTPRequest: a fragment (#...) is never sent to a server - leave it out, or spell a '#' in a query as %%23: '%s'"
msgstr "HTTPRequest: фрагмент (#...) никогда не отправляется на сервер - уберите его или запишите '#' в строке запроса как %%23: '%s'"

#: src/engine/backend/system/value/valueHttp.cpp:255
msgid "HTTPRequest: the headers are a Structure - a name and its value"
msgstr "HTTPRequest: заголовки - это Structure: имя и его значение"

#: src/engine/backend/system/value/valueHttp.cpp:308
msgid "HTTPRequest: SetBodyFromBinaryData takes a BinaryData"
msgstr "HTTPRequest: SetBodyFromBinaryData принимает BinaryData"

#: src/engine/backend/system/value/valueHttp.cpp:432
#, c-format
msgid "HTTPConnection: the host is a name - 'api.example' - not an address: the path goes into the request's ResourceAddress, and 'https' is the SecureConnection property: '%s'"
msgstr "HTTPConnection: хост - это имя ('api.example'), а не адрес: путь указывается в ResourceAddress запроса, а 'https' - это свойство SecureConnection: '%s'"

#: src/engine/backend/system/value/valueHttp.cpp:434
#, c-format
msgid "HTTPConnection: a host name is given in its ASCII form - an international name as its punycode (xn--...): '%s'"
msgstr "HTTPConnection: имя хоста указывается в форме ASCII - международное имя в виде punycode (xn--...): '%s'"

#: src/engine/backend/system/value/valueHttp.cpp:438
#, c-format
msgid "HTTPConnection: the port is the second argument, not a part of the host, and an IPv6 address is given bare - '::1', not '[::1]': '%s'"
msgstr "HTTPConnection: порт - второй аргумент, а не часть хоста, а адрес IPv6 указывается без скобок - '::1', а не '[::1]': '%s'"

#: src/engine/backend/system/value/valueHttp.cpp:440
msgid "HTTPConnection: a user name for Basic authorization cannot hold ':' - that is what parts it from the password"
msgstr "HTTPConnection: имя пользователя для Basic-авторизации не может содержать ':' - этим символом оно отделяется от пароля"

#: src/engine/backend/system/value/valueHttp.cpp:442
#, c-format
msgid "HTTPConnection: the port is 1 to 65535, and %d was given"
msgstr "HTTPConnection: порт должен быть от 1 до 65535, а передано %d"

#: src/engine/backend/system/value/valueHttp.cpp:466
msgid "HTTPConnection: SecureConnection is a SecureConnection value, or Undefined for plain http://"
msgstr "HTTPConnection: SecureConnection - это значение SecureConnection или Undefined для обычного http://"

#: src/engine/backend/system/value/valueHttp.cpp:475
#, c-format
msgid "HTTPConnection: the time allowed is a number of seconds, 1 or more - never 'forever': %d was given"
msgstr "HTTPConnection: отведённое время - число секунд, 1 или больше, и никогда не 'бесконечно': передано %d"

#: src/engine/backend/system/value/valueHttp.cpp:477
#, c-format
msgid "HTTPConnection: the time allowed is at most %d s, a day: %d was given"
msgstr "HTTPConnection: отведённое время - не более %d с (сутки): передано %d"

#: src/engine/backend/system/value/valueHttp.cpp:487
msgid "HTTPConnection: the method is an HTTPMethod value - HTTPMethod.Get, for one"
msgstr "HTTPConnection: метод задаётся значением HTTPMethod - например, HTTPMethod.Get"

