msgid "Post"
msgstr "Провести"

#: src/engine/backend/metaCollection/partial/documentAction.cpp:24
#: src/engine/backend/metaCollection/partial/documentAction.cpp:55
msgid "Clear posting"
msgstr "Отменить проведение"

