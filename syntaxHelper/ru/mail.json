      "signature": "Message.Texts : InternetMailTexts",
      "description": "Тексты письма — считаются, читаются и обходятся как коллекция, Add добавляет ещё один. Простые тексты уходят одним, соединённые в порядке добавления, как и HTML; если есть оба вида, программа читателя показывает тот, который умеет. Скрипт его не создаёт: он есть у письма.",
      "syntax_block": "Text = Message.Texts.Add(text, InternetMailTextType.HTML);",
      "parameters": "",
      "return_descr": "",
      "example": "Message.Texts.Add(\"The invoice is attached.\");\nMessage.Texts.Add(\"<p>The invoice is attached.</p>\", InternetMailTextType.HTML);",
      "availability": "Клиент, Сервер",
      "see_also": [
        "cls.InternetMailMessage.Texts",
        "cls.InternetMailTexts.Add",
        "enum.InternetMailTextType"
      ],
      "reviewed": false
    },
