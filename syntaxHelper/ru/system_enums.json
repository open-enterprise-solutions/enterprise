  "entries": [
    {
      "id": "enum.StatusMessage",
      "name_local": "StatusMessage",
      "name_en": "StatusMessage",
      "kind": "enum_type",
      "class_id": 430604137315061708,
      "category_keys": ["global_context", "system_enums"],
      "signature": "StatusMessage.Information, .Warning, .Error",
      "description": "Уровень сообщения: второй аргумент Message и WriteJournalEvent. Если не указан — Information. Окно сообщений рисует сообщение на его уровне, отлаживаемый запуск передаёт уровень в конфигуратор вместе с текстом, а строка журнала пишется с ним — по нему читатель и отбирает.\n\nError — слово приложения, а не платформы: сообщение показывается с уровнем ошибки, а скрипт продолжает работу. Чтобы остановиться, вызовите исключение (Raise).\n\nСравнивайте значение со значением, а не с его текстом: `String(StatusMessage.Error)` даёт подпись на языке пользователя.",
      "syntax_block": "Message(text, StatusMessage.Warning);",
      "syntax_block_ves": "Message(text, StatusMessage.Warning);",
      "parameters": "",
      "return_descr": "StatusMessage.",
      "example": "Message(\"Документ не проведён: нет остатка.\", StatusMessage.Error);\nWriteJournalEvent(\"Строка 17 пропущена: нет такого товара\", StatusMessage.Warning, \"import.line\");",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.StatusMessage.Information", "enum.StatusMessage.Warning", "enum.StatusMessage.Error", "fn.Message", "fn.WriteJournalEvent"],
      "reviewed": false
    },
    {
      "id": "enum.StatusMessage.Information",
      "name_local": "Information",
      "name_en": "Information",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "StatusMessage.Information",
      "description": "Обычное сообщение: что-то произошло, внимания не требуется. Значение по умолчанию, когда уровень не указан.",
      "syntax_block": "Message(text, StatusMessage.Information);",
      "parameters": "",
      "return_descr": "StatusMessage.",
      "example": "Message(\"Загрузка завершена: 1240 строк.\", StatusMessage.Information);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.StatusMessage", "fn.Message"],
      "reviewed": false
    },
    {
      "id": "enum.StatusMessage.Warning",
      "name_local": "Warning",
      "name_en": "Warning",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "StatusMessage.Warning",
      "description": "На это стоит посмотреть; ничего не отклонено. Строка журнала с этим уровнем пишется как предупреждение.",
      "syntax_block": "Message(text, StatusMessage.Warning);",
      "parameters": "",
      "return_descr": "StatusMessage.",
      "example": "Message(\"Прайс-лист старше месяца.\", StatusMessage.Warning);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.StatusMessage", "fn.Message", "fn.WriteJournalEvent"],
      "reviewed": false
    },
    {
      "id": "enum.StatusMessage.Error",
      "name_local": "Error",
      "name_en": "Error",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "StatusMessage.Error",
      "description": "Что-то не удалось или было отклонено. Сообщение показывается и пишется в журнал с уровнем ошибки; сам скрипт продолжает работу, если не вызовет исключение.",
      "syntax_block": "Message(text, StatusMessage.Error);",
      "parameters": "",
      "return_descr": "StatusMessage.",
      "example": "Message(\"Документ не проведён: нет остатка.\", StatusMessage.Error);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.StatusMessage", "fn.Message", "fn.Raise"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode",
      "name_local": "QuestionMode",
      "name_en": "QuestionMode",
      "kind": "enum_type",
      "class_id": 412506258289495458,
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.YesNo, .YesNoCancel, .Ok, .OkCancel",
      "description": "Какие кнопки предлагает Question: второй аргумент Question. Если не указан — Ok, одна кнопка. Ответ возвращается значением QuestionReturnCode по имени нажатой кнопки.\n\nЕсли у сеанса нет окна, где спросить (фоновое задание, скрипт без клиента), Question отвечает Cancel, ничего не спрашивая; при вычислении (наблюдение в отладчике, проба ассистента) — пустым значением.",
      "syntax_block": "Answer = Question(text, QuestionMode.YesNo);",
      "syntax_block_ves": "Answer = Question(text, QuestionMode.YesNo);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Answer = Question(\"Провести документ?\", QuestionMode.YesNoCancel);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.QuestionMode.YesNo", "enum.QuestionMode.YesNoCancel", "enum.QuestionMode.Ok", "enum.QuestionMode.OkCancel", "enum.QuestionReturnCode", "fn.Question"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode.YesNo",
      "name_local": "YesNo",
      "name_en": "YesNo",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.YesNo",
      "description": "Две кнопки, «Да» и «Нет». Ответ — QuestionReturnCode.Yes или .No.",
      "syntax_block": "Answer = Question(text, QuestionMode.YesNo);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Answer = Question(\"Удалить черновик?\", QuestionMode.YesNo);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.QuestionMode", "enum.QuestionReturnCode.Yes", "enum.QuestionReturnCode.No"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode.YesNoCancel",
      "name_local": "YesNoCancel",
      "name_en": "YesNoCancel",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.YesNoCancel",
      "description": "Три кнопки, «Да», «Нет» и «Отмена» — для вопроса, где «не сейчас» не то же, что «нет». Ответ — QuestionReturnCode.Yes, .No или .Cancel.",
      "syntax_block": "Answer = Question(text, QuestionMode.YesNoCancel);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Answer = Question(\"Сохранить изменения перед закрытием?\", QuestionMode.YesNoCancel);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.QuestionMode", "enum.QuestionReturnCode"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode.Ok",
      "name_local": "Ok",
      "name_en": "Ok",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.Ok",
      "description": "Одна кнопка, «ОК». Значение по умолчанию, когда режим не указан. Ответ — QuestionReturnCode.Ok.",
      "syntax_block": "Question(text, QuestionMode.Ok);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Question(\"Период закрыт.\", QuestionMode.Ok);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.QuestionMode", "enum.QuestionReturnCode.Ok", "fn.Alert"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode.OkCancel",
      "name_local": "OkCancel",
      "name_en": "OkCancel",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.OkCancel",
      "description": "Две кнопки, «ОК» и «Отмена» — продолжить или отступить. Ответ — QuestionReturnCode.Ok или .Cancel.",
      "syntax_block": "Answer = Question(text, QuestionMode.OkCancel);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Answer = Question(\"Пересчитать все строки?\", QuestionMode.OkCancel);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.QuestionMode", "enum.QuestionReturnCode.Ok", "enum.QuestionReturnCode.Cancel"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode",
      "name_local": "QuestionReturnCode",
      "name_en": "QuestionReturnCode",
      "kind": "enum_type",
      "class_id": 430532751430419528,
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.Yes, .No, .Ok, .Cancel",
      "description": "Что отвечает Question: кнопку, которую нажал человек. Сравнивайте со значением — `Answer = QuestionReturnCode.Yes`.\n\nЕсли у сеанса нет окна, где спросить (фоновое задание, скрипт без клиента), ответ — Cancel, а вопрос не показывается; при вычислении (наблюдение в отладчике, проба ассистента) — пустое значение, не равное ни одному из значений перечисления.",
      "syntax_block": "if (Question(text, QuestionMode.YesNo) = QuestionReturnCode.Yes) {\n    // человек согласился\n}",
      "syntax_block_ves": "If Question(text, QuestionMode.YesNo) = QuestionReturnCode.Yes Then\n    // человек согласился\nEndIf;",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "Answer = Question(\"Провести документ?\", QuestionMode.YesNo);\nPost = (Answer = QuestionReturnCode.Yes);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.QuestionReturnCode.Yes", "enum.QuestionReturnCode.No", "enum.QuestionReturnCode.Ok", "enum.QuestionReturnCode.Cancel", "enum.QuestionMode", "fn.Question"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode.Yes",
      "name_local": "Yes",
      "name_en": "Yes",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.Yes",
      "description": "Человек нажал «Да» (QuestionMode.YesNo или .YesNoCancel).",
      "syntax_block": "if (Answer = QuestionReturnCode.Yes) { }",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "Agreed = (Question(\"Провести документ?\", QuestionMode.YesNo) = QuestionReturnCode.Yes);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.QuestionReturnCode", "enum.QuestionMode.YesNo"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode.No",
      "name_local": "No",
      "name_en": "No",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.No",
      "description": "Человек нажал «Нет» (QuestionMode.YesNo или .YesNoCancel).",
      "syntax_block": "if (Answer = QuestionReturnCode.No) { }",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "Declined = (Answer = QuestionReturnCode.No);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.QuestionReturnCode", "enum.QuestionMode.YesNo"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode.Ok",
      "name_local": "Ok",
      "name_en": "Ok",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.Ok",
      "description": "Человек нажал «ОК» (QuestionMode.Ok или .OkCancel).",
      "syntax_block": "if (Answer = QuestionReturnCode.Ok) { }",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "Go = (Question(\"Пересчитать все строки?\", QuestionMode.OkCancel) = QuestionReturnCode.Ok);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.QuestionReturnCode", "enum.QuestionMode.OkCancel"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode.Cancel",
      "name_local": "Cancel",
      "name_en": "Cancel",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.Cancel",
      "description": "Человек нажал «Отмена» — или спросить было некого, потому что у сеанса нет окна (фоновое задание, скрипт без клиента). Понимайте как «ничего не делать».",
      "syntax_block": "if (Answer = QuestionReturnCode.Cancel) { }",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "StepBack = (Answer = QuestionReturnCode.Cancel);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.QuestionReturnCode", "enum.QuestionMode.OkCancel", "enum.QuestionMode.YesNoCancel"],
      "reviewed": false
    },
    {
      "id": "enum.RoundMode",
      "name_local": "RoundMode",
      "name_en": "RoundMode",
      "kind": "enum_type",
      "class_id": 409888286779662112,
      "category_keys": ["global_context", "system_enums"],
      "signature": "RoundMode.Round15as10, .Round15as20",
      "description": "Правило округления: третий аргумент Round. Два правила расходятся только на одном входе — РОВНО половине последнего сохраняемого разряда. Round15as20 (по умолчанию) уводит её от нуля, Round15as10 — к нулю; всё, что больше половины, по обоим правилам уходит от нуля.\n\nУказывайте правило явно везде, где сумма сверяется с другой системой.",
      "syntax_block": "Value = Round(number, places, RoundMode.Round15as10);",
      "syntax_block_ves": "Value = Round(number, places, RoundMode.Round15as10);",
      "parameters": "",
      "return_descr": "RoundMode.",
      "example": "Message(Round(1.25, 1));                          // 1.3\nMessage(Round(1.25, 1, RoundMode.Round15as10));   // 1.2\nMessage(Round(1.251, 1, RoundMode.Round15as10));  // 1.3",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.RoundMode.Round15as10", "enum.RoundMode.Round15as20", "fn.Round"],
      "reviewed": false
    },
    {
      "id": "enum.RoundMode.Round15as10",
      "name_local": "Round15as10",
      "name_en": "Round15as10",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "RoundMode.Round15as10",
      "description": "Ровно половина уходит к нулю: 1.5 становится 1, -1.5 становится -1. Больше половины — как обычно, от нуля: 1.51 и 1.6 становятся 2.",
      "syntax_block": "Round(number, places, RoundMode.Round15as10)",
      "parameters": "",
      "return_descr": "RoundMode.",
      "example": "Message(Round(1.5, 0, RoundMode.Round15as10));   // 1",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.RoundMode", "fn.Round"],
      "reviewed": false
    },
    {
      "id": "enum.RoundMode.Round15as20",
      "name_local": "Round15as20",
      "name_en": "Round15as20",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "RoundMode.Round15as20",
      "description": "Ровно половина уходит от нуля: 1.5 становится 2, -1.5 становится -2. Правило по умолчанию, когда Round не передано другое.",
      "syntax_block": "Round(number, places, RoundMode.Round15as20)",
      "parameters": "",
      "return_descr": "RoundMode.",
      "example": "Message(Round(1.25, 1, RoundMode.Round15as20));   // 1.3",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.RoundMode", "fn.Round"],
      "reviewed": false
    },
    {
      "id": "enum.Chars",
      "name_local": "Chars",
      "name_en": "Chars",
      "kind": "enum_type",
      "class_id": 391176189795626039,
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.CR, .FF, .LF, .NBSp, .Tab, .VTab",
      "description": "Символы, которые не набрать в строковом литерале, — по имени. Значение ЧИТАЕТСЯ КАК САМ СИМВОЛ: `\"a\" + Chars.LF + \"b\"` — две строки длиной три символа, а `Asc(Chars.Tab)` равно 9. Те же символы даёт `Chr(code)`; имя говорит, какой из них имеется в виду.",
      "syntax_block": "Text = \"Первая строка\" + Chars.LF + \"Вторая строка\";",
      "syntax_block_ves": "Text = \"Первая строка\" + Chars.LF + \"Вторая строка\";",
      "parameters": "",
      "return_descr": "Строка из одного символа.",
      "example": "Row = \"Бумага\" + Chars.Tab + \"12\";\nText = \"Итого:\" + Chars.CR + Chars.LF + \"12 шт.\";\nMessage(StrLineCount(Text));   // 2",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.Chars.CR", "enum.Chars.FF", "enum.Chars.LF", "enum.Chars.NBSp", "enum.Chars.Tab", "enum.Chars.VTab", "fn.Chr", "fn.Asc", "fn.StrLineCount"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.CR",
      "name_local": "CR",
      "name_en": "CR",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.CR",
      "description": "Возврат каретки, код 13. Вместе с LF — перевод строки в текстовых файлах, записанных в Windows. StrLineCount и StrGetLine считают пару одним переводом, а одиночный CR — тоже переводом.",
      "syntax_block": "Text = First + Chars.CR + Chars.LF + Second;",
      "parameters": "",
      "return_descr": "Строка из одного символа.",
      "example": "Line = \"12 шт.\" + Chars.CR + Chars.LF;",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.Chars", "enum.Chars.LF", "fn.StrLineCount"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.FF",
      "name_local": "FF",
      "name_en": "FF",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.FF",
      "description": "Перевод формата, код 12 — разрыв страницы в простом тексте, отправленном на принтер.",
      "syntax_block": "Text = Page1 + Chars.FF + Page2;",
      "parameters": "",
      "return_descr": "Строка из одного символа.",
      "example": "Text = \"Страница 1\" + Chars.FF + \"Страница 2\";",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.Chars"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.LF",
      "name_local": "LF",
      "name_en": "LF",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.LF",
      "description": "Перевод строки, код 10. StrGetLine и StrLineCount делят текст по нему.",
      "syntax_block": "Text = First + Chars.LF + Second;",
      "parameters": "",
      "return_descr": "Строка из одного символа.",
      "example": "Message(\"Проведено: 12\" + Chars.LF + \"Пропущено: 3\");",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.Chars", "enum.Chars.CR", "fn.StrGetLine", "fn.StrLineCount"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.NBSp",
      "name_local": "NBSp",
      "name_en": "NBSp",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.NBSp",
      "description": "Неразрывный пробел, код 160: на нём строка никогда не переносится — между числом и единицей измерения, внутри числа с разделителями разрядов. TrimAll не считает его пробелом: замените его, прежде чем чистить текст, пришедший извне.",
      "syntax_block": "Text = Amount + Chars.NBSp + \"руб.\";",
      "parameters": "",
      "return_descr": "Строка из одного символа.",
      "example": "Clean = StrReplace(Imported, Chars.NBSp, \" \");",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.Chars", "fn.StrReplace"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.Tab",
      "name_local": "Tab",
      "name_en": "Tab",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.Tab",
      "description": "Горизонтальная табуляция, код 9 — разделитель колонок в тексте с табуляциями.",
      "syntax_block": "Row = Item + Chars.Tab + Quantity;",
      "parameters": "",
      "return_descr": "Строка из одного символа.",
      "example": "Fields = StrSplit(Line, Chars.Tab);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.Chars", "fn.StrSplit"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.VTab",
      "name_local": "VTab",
      "name_en": "VTab",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.VTab",
      "description": "Вертикальная табуляция, код 11. В тексте редка; некоторые выгрузки обозначают ею перевод строки внутри ячейки.",
      "syntax_block": "Text = First + Chars.VTab + Second;",
      "parameters": "",
      "return_descr": "Строка из одного символа.",
      "example": "Clean = StrReplace(Cell, Chars.VTab, Chars.LF);",
      "availability": "Клиент, Сервер",
      "see_also": ["enum.Chars"],
      "reviewed": false
    }
  ]
}
