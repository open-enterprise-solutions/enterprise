        "linq"
      ],
      "signature": "ascending",
      "description": "Модификатор направления для клаузы `orderby` — сортирует по возрастанию. По умолчанию когда направление не указано; редко требуется явно.",
      "syntax_block": "from x in arr orderby x ascending select x;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
