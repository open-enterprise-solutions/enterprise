      "name_en": "To",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Верхняя граница (включительно) счётного цикла For.",
      "syntax_block": "For i = 1 To 10 Do … EndDo;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.For"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.In",
      "name_local": "In",
      "name_en": "In",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Указывает коллекцию-источник в цикле For Each.",
      "syntax_block": "For Each <Item> In <Collection> Do … EndDo;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.For",
        "kw.Foreach"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Do",
      "name_local": "Do",
      "name_en": "Do",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Открывает тело цикла While или For.",
      "syntax_block": "While <Cond> Do … EndDo;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.While",
        "kw.For",
        "kw.EndDo"
      ],
      "reviewed": true,
      "modes": [
        "ves"
      ]
    },
    {
      "id": "kw.EndDo",
      "name_local": "EndDo",
      "name_en": "EndDo",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Закрывает тело цикла While или For.",
      "syntax_block": "While X Do\n    // …\nEndDo;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.While",
        "kw.For",
        "kw.Do"
      ],
      "reviewed": true,
      "modes": [
        "ves"
      ]
    },
    {
      "id": "kw.While",
      "name_local": "While",
      "name_en": "While",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Цикл с предусловием. Перед каждой итерацией проверяет условие; выполняет тело, пока условие истинно.",
      "syntax_block": "while (<Condition>) {\n    // body\n}",
      "parameters": "",
      "return_descr": "",
      "example": "Counter = 0;\nwhile (Counter < 10) {\n    Counter = Counter + 1;\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.For",
        "kw.Break",
        "kw.Continue"
      ],
      "reviewed": true,
      "syntax_block_ves": "While <Condition> Do\n    // body\nEndDo;",
      "example_ves": "Counter = 0;\nWhile Counter < 10 Do\n    Counter = Counter + 1;\nEndDo;",
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.GoTo",
      "name_local": "GoTo",
      "name_en": "GoTo",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Безусловный переход к помеченному оператору в пределах того же блока. Применяйте умеренно — почти всегда чище переписать через цикл или функцию.",
      "syntax_block": "GoTo ~<Label>;\n…\n~<Label>:",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Not",
      "name_local": "Not",
      "name_en": "Not",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Логическое отрицание.",
      "syntax_block": "Not <Expression>",
      "parameters": "",
      "return_descr": "",
      "example": "If Not User.IsLoggedIn Then\n    ShowLoginForm();\nEndIf;",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.And",
        "kw.Or"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.And",
      "name_local": "And",
      "name_en": "And",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Логическое И. Короткое замыкание: правый операнд не вычисляется, если левый — False.",
      "syntax_block": "<LeftExpr> And <RightExpr>",
      "parameters": "",
      "return_descr": "",
      "example": "If User.IsLoggedIn And User.Role = \"admin\" Then\n    ShowAdminPanel();\nEndIf;",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Or",
        "kw.Not"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Or",
      "name_local": "Or",
      "name_en": "Or",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Логическое ИЛИ. Короткое замыкание: правый операнд не вычисляется, если левый — True.",
      "syntax_block": "<LeftExpr> Or <RightExpr>",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.And",
        "kw.Not"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Procedure",
      "name_local": "Procedure",
      "name_en": "Procedure",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Объявляет процедуру — вызываемый блок кода, который выполняет действия, но не возвращает значение. Когда вызывающему нужен результат — используйте Function.",
      "syntax_block": "Procedure <Name>([Val] <Param1>, [Val] <Param2>, …) [Export] {\n    // body\n}",
      "parameters": "<Name> — идентификатор. Val — модификатор «по значению». Export — делает процедуру доступной из других модулей.",
      "return_descr": "",
      "example": "Procedure LogMessage(Val Text) Export {\n    Message(Text);\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Function",
        "kw.Return",
        "kw.Export",
        "kw.Val"
      ],
      "reviewed": true,
      "syntax_block_ves": "Procedure <Name>([Val] <Param1>, [Val] <Param2>, …) [Export]\n    // body\nEndProcedure",
      "example_ves": "Procedure LogMessage(Val Text) Export\n    Message(Text);\nEndProcedure",
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.EndProcedure",
      "name_local": "EndProcedure",
      "name_en": "EndProcedure",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Закрывает тело процедуры. Управление возвращается вызывающему коду при достижении EndProcedure.",
      "syntax_block": "Procedure Demo()\n    // …\nEndProcedure",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Procedure"
      ],
      "reviewed": true,
      "modes": [
        "ves"
      ]
    },
    {
      "id": "kw.Function",
      "name_local": "Function",
      "name_en": "Function",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Объявляет функцию — вызываемый блок кода, возвращающий значение через Return. Функции взаимозаменяемы с процедурами везде, кроме использования в качестве источника выражения.",
      "syntax_block": "Function <Name>([Val] <Param1>, …) [Export] {\n    // body\n    Return <Value>;\n}",
      "parameters": "<Name> — идентификатор. Val — модификатор «по значению». Export — делает функцию доступной из других модулей.",
      "return_descr": "Значение, переданное оператору Return.",
      "example": "Function Sum(Val A, Val B) Export {\n    Return A + B;\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Procedure",
        "kw.Return",
        "kw.Export"
      ],
      "reviewed": true,
      "syntax_block_ves": "Function <Name>([Val] <Param1>, …) [Export]\n    // body\n    Return <Value>;\nEndFunction",
      "example_ves": "Function Sum(Val A, Val B) Export\n    Return A + B;\nEndFunction",
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.EndFunction",
      "name_local": "EndFunction",
      "name_en": "EndFunction",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Закрывает тело функции. Достижение EndFunction без оператора Return приводит к возврату Undefined.",
      "syntax_block": "Function Demo()\n    Return 42;\nEndFunction",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Function",
        "kw.Return",
        "kw.Undefined"
      ],
      "reviewed": true,
      "modes": [
        "ves"
      ]
    },
    {
      "id": "kw.Export",
      "name_local": "Export",
      "name_en": "Export",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Помечает процедуру, функцию или модульную переменную как доступную из других модулей. Без Export символ виден только в своём модуле.",
      "syntax_block": "Procedure DoWork() Export\n    // body\nEndProcedure",
      "parameters": "",
      "return_descr": "",
      "example": "Var Counter Export;  // module-public variable\n\nFunction Read() Export\n    Return Counter;\nEndFunction",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Procedure",
        "kw.Function",
        "kw.Var"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Val",
      "name_local": "Val",
      "name_en": "Val",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Модификатор параметра «по значению». Без Val параметр связан по ссылке, и присваивания внутри вызываемого кода меняют переменную вызывающего; со Val берётся локальная копия.",
      "syntax_block": "Procedure Demo(Val ReadOnlyParam, MutableParam)\n    // ReadOnlyParam is a copy of the caller's value.\n    // MutableParam writes back into the caller's variable.\nEndProcedure",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Procedure",
        "kw.Function"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Return",
      "name_local": "Return",
      "name_en": "Return",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Завершает текущую процедуру или функцию. Внутри функции может содержать возвращаемое выражение.",
      "syntax_block": "Return;                 // exit procedure\nReturn <Expression>;    // exit function with result",
      "parameters": "",
      "return_descr": "",
      "example": "Function Sign(Val X)\n    If X < 0 Then Return -1; EndIf;\n    If X > 0 Then Return 1;  EndIf;\n    Return 0;\nEndFunction",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Function",
        "kw.Procedure"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Try",
      "name_local": "Try",
      "name_en": "Try",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Начинает блок обработки исключений. Код внутри отслеживается; возникшее исключение передаёт управление в ветку Except.",
      "syntax_block": "try {\n    // protected body\n} except {\n    // handler — runs on any raised exception\n}",
      "parameters": "",
      "return_descr": "",
      "example": "try {\n    Result = ParseNumber(UserInput);\n} except {\n    Message(\"Not a valid number: \" + ErrorDescription());\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Except",
        "kw.Raise"
      ],
      "reviewed": true,
      "syntax_block_ves": "Try\n    // protected body\nExcept\n    // handler — runs on any raised exception\nEndTry;",
      "example_ves": "Try\n    Result = ParseNumber(UserInput);\nExcept\n    Message(\"Not a valid number: \" + ErrorDescription());\nEndTry;",
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Except",
      "name_local": "Except",
      "name_en": "Except",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Открывает ветку обработчика конструкции Try / Except. Выполняется, если защищённый блок породил исключение.",
      "syntax_block": "Try\n    // …\nExcept\n    // recovery\nEndTry;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Try",
        "kw.Endtry",
        "kw.Raise"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Endtry",
      "name_local": "Endtry",
      "name_en": "Endtry",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Закрывает конструкцию Try / Except.",
      "syntax_block": "Try … Except … EndTry;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Try",
