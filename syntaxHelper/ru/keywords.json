    {
      "id": "kw.From",
      "name_local": "From",
      "name_en": "From",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "linq"
      ],
      "signature": "from <Item> in <Source>",
      "description": "Открывает блочный LINQ-запрос. Привязывает переменную элемента к каждому элементу исходной коллекции. Первая клауза любого block-syntax LINQ-запроса.",
      "syntax_block": "from <Item> in <Source>\n    where <Condition>\n    select <Item>;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "guide.linq",
        "kw.Where",
        "kw.Select",
        "kw.In"
      ],
      "modes": [
        "ves",
        "ces"
      ],
      "reviewed": true
    },
    {
      "id": "kw.Where",
      "name_local": "Where",
      "name_en": "Where",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "linq"
      ],
      "signature": "where <BooleanExpression>",
      "description": "Клауза фильтра в LINQ-запросе — оставляет строки, удовлетворяющие булевому выражению. Может появляться несколько раз; условия объединяются неявным AND.",
      "syntax_block": "from x in arr where x > 5 select x;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "guide.linq",
        "kw.From",
        "kw.Select"
      ],
      "modes": [
        "ves",
        "ces"
      ],
      "reviewed": true
    },
    {
      "id": "kw.Select",
      "name_local": "Select",
      "name_en": "Select",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "linq"
      ],
      "signature": "select <Expression> | select { Field = expr, ... }",
      "description": "Клауза проекции — закрывает блочный LINQ-запрос, эмитируя одну строку на каждое совпадение. Форма `select <Expr>` для скаляра, или `select { Field = expr, ... }` для анонимной строки-Structure.",
      "syntax_block": "from o in orders select o.Total;\n\nfrom o in orders select { N = o.N, Total = o.Total };",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "guide.linq",
        "kw.From",
        "kw.Where"
      ],
      "modes": [
        "ves",
        "ces"
      ],
      "reviewed": true
