    {
      "id": "kw.OrderBy",
      "name_local": "OrderBy",
      "name_en": "OrderBy",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "linq"
      ],
      "signature": "orderby <Expression> [ascending|descending]",
      "description": "Клауза сортировки LINQ-запроса. Направление по умолчанию — возрастание; добавьте `descending` для убывания. Один ключ сортировки — для много-колоночной комбинируйте составным выражением.",
      "syntax_block": "from x in arr orderby x select x;\nfrom x in arr orderby x descending select x;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "guide.linq",
        "kw.Ascending",
        "kw.Descending"
      ],
      "modes": [
