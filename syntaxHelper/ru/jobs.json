      ],
      "reviewed": false
    },
    {
      "id": "cls.BackgroundJob.IsComplete",
      "name_local": "IsComplete",
      "name_en": "IsComplete",
      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJob.IsComplete()",
      "description": "Истина, когда запуск закончился, как бы он ни закончился.",
      "syntax_block": "Done = Job.IsComplete();",
      "parameters": "",
      "return_descr": "Булево.",
      "example": "if (Job.IsComplete()) { Message(Job.State); }",
      "availability": "Сервер",
      "see_also": [
        "cls.BackgroundJob",
        "cls.BackgroundJob.Wait"
      ],
      "reviewed": false
    },
    {
      "id": "cls.BackgroundJob.Wait",
      "name_local": "Wait",
      "name_en": "Wait",
      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJob.Wait([timeoutMs : number])",
      "description": "Ждёт окончания запуска не дольше таймаута в миллисекундах; 0 или без аргумента — до конца. Отвечает IsComplete(): Ложь значит, что время вышло, а не что запуск упал.",
      "syntax_block": "Done = Job.Wait(60000);",
      "parameters": "timeoutMs — сколько миллисекунд ждать самое большее.",
      "return_descr": "Булево.",
      "example": "if (not Job.Wait(60000)) { Message(\"ещё выполняется\"); }",
      "availability": "Сервер",
      "see_also": [
        "cls.BackgroundJob",
        "cls.BackgroundJob.State"
      ],
      "reviewed": false
    },
    {
      "id": "cls.BackgroundJob.Result",
      "name_local": "Result",
      "name_en": "Result",
      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJob.Result()",
      "description": "Что вернул метод. Пусто, пока запуск идёт, и пусто после, если он упал, — различает их Error().",
