    {
      "id": "enum.ButtonView",
      "name_local": "ButtonView",
      "name_en": "ButtonView",
      "kind": "enum_type",
      "class_id": 431239117940110366,
      "category_keys": [
        "value_types",
        "runtime",
        "forms"
      ],
      "signature": "ButtonView.Button, .Hyperlink",
      "description": "Как рисуется кнопка: обычной кнопкой или гиперссылкой - та же кнопка без фона и рамки, с подчёркнутой надписью. Свойство кнопки View хранит значение, записывается ButtonView.<Имя>. Нажимается одинаково; картинка, её положение и команда не меняются.\n\nСкрипт читает и задаёт его у кнопки формы: `Controls.Button1.View = ButtonView.Hyperlink;`.",
      "syntax_block": "Controls.Button1.View = ButtonView.Hyperlink;",
      "syntax_block_ves": "Controls.Button1.View = ButtonView.Hyperlink;",
      "parameters": "",
      "return_descr": "ButtonView.",
      "example": "Controls.Button1.View = ButtonView.Hyperlink;",
      "availability": "Thin client, Server",
      "see_also": [
        "enum.ButtonView.Button",
        "enum.ButtonView.Hyperlink",
        "enum.PictureLocation"
      ],
      "reviewed": false
    },
    {
