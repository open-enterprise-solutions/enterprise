    {
      "id": "enum.PictureLocation.Tile",
      "name_local": "Tile",
      "name_en": "Tile",
      "kind": "system_enum",
      "category_keys": [
        "value_types",
        "runtime",
        "forms"
      ],
      "signature": "PictureLocation.Tile",
      "description": "Кнопка под палец: крупная картинка над надписью, под ними Note кнопки мелким шрифтом (цена, количество, состояние), и всё это заполняет то, что даёт сайзер. Плитки в сайзере-сетке складываются в панель. Клиент старше протокола 8 показывает картинку слева и без примечания.",
