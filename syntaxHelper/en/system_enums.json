{
  "format": "OES-HELP-1.0",
  "schema_version": 1,
  "locale": "en",
  "entries": [
    {
      "id": "enum.StatusMessage",
      "name_local": "StatusMessage",
      "name_en": "StatusMessage",
      "kind": "enum_type",
      "class_id": 430604137315061708,
      "category_keys": ["global_context", "system_enums"],
      "signature": "StatusMessage.Information, .Warning, .Error",
      "description": "The level of a message: the second argument of Message and of WriteJournalEvent. Left out, it is Information. The message window paints a message at its level, a run being debugged sends the level to the designer with the text, and a journal line is written at it - which is what a reader filters by.\n\nError is the application's word, not the platform's: the message is shown at error level and the script carries on. To stop, raise (Raise).\n\nCompare a member with a member, never with its text: `String(StatusMessage.Error)` gives the caption in the user's language.",
      "syntax_block": "Message(text, StatusMessage.Warning);",
      "syntax_block_ves": "Message(text, StatusMessage.Warning);",
      "parameters": "",
      "return_descr": "StatusMessage.",
      "example": "Message(\"The document did not post: no stock left.\", StatusMessage.Error);\nWriteJournalEvent(\"Row 17 skipped: no such item\", StatusMessage.Warning, \"import.line\");",
      "availability": "Client, Server",
      "see_also": ["enum.StatusMessage.Information", "enum.StatusMessage.Warning", "enum.StatusMessage.Error", "fn.Message", "fn.WriteJournalEvent"],
      "reviewed": false
    },
    {
      "id": "enum.StatusMessage.Information",
      "name_local": "Information",
      "name_en": "Information",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "StatusMessage.Information",
      "description": "An ordinary message: something happened, nothing needs attention. The default when the level is left out.",
      "syntax_block": "Message(text, StatusMessage.Information);",
      "parameters": "",
      "return_descr": "StatusMessage.",
      "example": "Message(\"Import finished: 1240 rows.\", StatusMessage.Information);",
      "availability": "Client, Server",
      "see_also": ["enum.StatusMessage", "fn.Message"],
      "reviewed": false
    },
    {
      "id": "enum.StatusMessage.Warning",
      "name_local": "Warning",
      "name_en": "Warning",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "StatusMessage.Warning",
      "description": "Something the reader should look at; nothing was refused. A journal line at this level is written as a warning.",
      "syntax_block": "Message(text, StatusMessage.Warning);",
      "parameters": "",
      "return_descr": "StatusMessage.",
      "example": "Message(\"The price list is older than a month.\", StatusMessage.Warning);",
      "availability": "Client, Server",
      "see_also": ["enum.StatusMessage", "fn.Message", "fn.WriteJournalEvent"],
      "reviewed": false
    },
    {
      "id": "enum.StatusMessage.Error",
      "name_local": "Error",
      "name_en": "Error",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "StatusMessage.Error",
      "description": "Something failed or was refused. The message is shown and journalled at error level; the script itself goes on unless it raises.",
      "syntax_block": "Message(text, StatusMessage.Error);",
      "parameters": "",
      "return_descr": "StatusMessage.",
      "example": "Message(\"The document did not post: no stock left.\", StatusMessage.Error);",
      "availability": "Client, Server",
      "see_also": ["enum.StatusMessage", "fn.Message", "fn.Raise"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode",
      "name_local": "QuestionMode",
      "name_en": "QuestionMode",
      "kind": "enum_type",
      "class_id": 412506258289495458,
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.YesNo, .YesNoCancel, .Ok, .OkCancel",
      "description": "Which buttons Question offers: the second argument of Question. Left out, it is Ok - a single button. The answer comes back as a QuestionReturnCode named after the button pressed.\n\nWhere the session has no window to ask in (a background job, a script run without a client), Question answers Cancel without asking; under an evaluation (a debugger watch, an assistant's probe) it answers an empty value.",
      "syntax_block": "Answer = Question(text, QuestionMode.YesNo);",
      "syntax_block_ves": "Answer = Question(text, QuestionMode.YesNo);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Answer = Question(\"Post the document?\", QuestionMode.YesNoCancel);",
      "availability": "Client, Server",
      "see_also": ["enum.QuestionMode.YesNo", "enum.QuestionMode.YesNoCancel", "enum.QuestionMode.Ok", "enum.QuestionMode.OkCancel", "enum.QuestionReturnCode", "fn.Question"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode.YesNo",
      "name_local": "YesNo",
      "name_en": "YesNo",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.YesNo",
      "description": "Two buttons, Yes and No. The answer is QuestionReturnCode.Yes or .No.",
      "syntax_block": "Answer = Question(text, QuestionMode.YesNo);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Answer = Question(\"Delete the draft?\", QuestionMode.YesNo);",
      "availability": "Client, Server",
      "see_also": ["enum.QuestionMode", "enum.QuestionReturnCode.Yes", "enum.QuestionReturnCode.No"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode.YesNoCancel",
      "name_local": "YesNoCancel",
      "name_en": "YesNoCancel",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.YesNoCancel",
      "description": "Three buttons, Yes, No and Cancel - for a question where \"not now\" differs from \"no\". The answer is QuestionReturnCode.Yes, .No or .Cancel.",
      "syntax_block": "Answer = Question(text, QuestionMode.YesNoCancel);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Answer = Question(\"Save the changes before closing?\", QuestionMode.YesNoCancel);",
      "availability": "Client, Server",
      "see_also": ["enum.QuestionMode", "enum.QuestionReturnCode"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode.Ok",
      "name_local": "Ok",
      "name_en": "Ok",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.Ok",
      "description": "One button, OK. The default when the mode is left out. The answer is QuestionReturnCode.Ok.",
      "syntax_block": "Question(text, QuestionMode.Ok);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Question(\"The period is closed.\", QuestionMode.Ok);",
      "availability": "Client, Server",
      "see_also": ["enum.QuestionMode", "enum.QuestionReturnCode.Ok", "fn.Alert"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode.OkCancel",
      "name_local": "OkCancel",
      "name_en": "OkCancel",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.OkCancel",
      "description": "Two buttons, OK and Cancel - to go ahead or to step back. The answer is QuestionReturnCode.Ok or .Cancel.",
      "syntax_block": "Answer = Question(text, QuestionMode.OkCancel);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Answer = Question(\"Recalculate every line?\", QuestionMode.OkCancel);",
      "availability": "Client, Server",
      "see_also": ["enum.QuestionMode", "enum.QuestionReturnCode.Ok", "enum.QuestionReturnCode.Cancel"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode",
      "name_local": "QuestionReturnCode",
      "name_en": "QuestionReturnCode",
      "kind": "enum_type",
      "class_id": 430532751430419528,
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.Yes, .No, .Ok, .Cancel",
      "description": "What Question answers: the button the person pressed. Compare it with a member - `Answer = QuestionReturnCode.Yes`.\n\nWhere the session has no window to ask in (a background job, a script run without a client) the answer is Cancel without a question shown; under an evaluation (a debugger watch, an assistant's probe) it is an empty value that equals none of the members.",
      "syntax_block": "if (Question(text, QuestionMode.YesNo) = QuestionReturnCode.Yes) {\n    // the person agreed\n}",
      "syntax_block_ves": "If Question(text, QuestionMode.YesNo) = QuestionReturnCode.Yes Then\n    // the person agreed\nEndIf;",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "Answer = Question(\"Post the document?\", QuestionMode.YesNo);\nPost = (Answer = QuestionReturnCode.Yes);",
      "availability": "Client, Server",
      "see_also": ["enum.QuestionReturnCode.Yes", "enum.QuestionReturnCode.No", "enum.QuestionReturnCode.Ok", "enum.QuestionReturnCode.Cancel", "enum.QuestionMode", "fn.Question"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode.Yes",
      "name_local": "Yes",
      "name_en": "Yes",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.Yes",
      "description": "The person pressed Yes (QuestionMode.YesNo or .YesNoCancel).",
      "syntax_block": "if (Answer = QuestionReturnCode.Yes) { }",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "Agreed = (Question(\"Post the document?\", QuestionMode.YesNo) = QuestionReturnCode.Yes);",
      "availability": "Client, Server",
      "see_also": ["enum.QuestionReturnCode", "enum.QuestionMode.YesNo"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode.No",
      "name_local": "No",
      "name_en": "No",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.No",
      "description": "The person pressed No (QuestionMode.YesNo or .YesNoCancel).",
      "syntax_block": "if (Answer = QuestionReturnCode.No) { }",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "Declined = (Answer = QuestionReturnCode.No);",
      "availability": "Client, Server",
      "see_also": ["enum.QuestionReturnCode", "enum.QuestionMode.YesNo"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode.Ok",
      "name_local": "Ok",
      "name_en": "Ok",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.Ok",
      "description": "The person pressed OK (QuestionMode.Ok or .OkCancel).",
      "syntax_block": "if (Answer = QuestionReturnCode.Ok) { }",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "Go = (Question(\"Recalculate every line?\", QuestionMode.OkCancel) = QuestionReturnCode.Ok);",
      "availability": "Client, Server",
      "see_also": ["enum.QuestionReturnCode", "enum.QuestionMode.OkCancel"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode.Cancel",
      "name_local": "Cancel",
      "name_en": "Cancel",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.Cancel",
      "description": "The person pressed Cancel - or nobody could be asked, because the session has no window (a background job, a script run without a client). Treat it as \"do nothing\".",
      "syntax_block": "if (Answer = QuestionReturnCode.Cancel) { }",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "StepBack = (Answer = QuestionReturnCode.Cancel);",
      "availability": "Client, Server",
      "see_also": ["enum.QuestionReturnCode", "enum.QuestionMode.OkCancel", "enum.QuestionMode.YesNoCancel"],
      "reviewed": false
    },
    {
      "id": "enum.RoundMode",
      "name_local": "RoundMode",
      "name_en": "RoundMode",
      "kind": "enum_type",
      "class_id": 409888286779662112,
      "category_keys": ["global_context", "system_enums"],
      "signature": "RoundMode.Round15as10, .Round15as20",
      "description": "The rounding rule: the third argument of Round. The two rules differ on one input only - an EXACT half of the last kept place. Round15as20 (the default) sends it away from zero, Round15as10 towards zero; anything past the half goes away from zero under both.\n\nState the rule wherever a figure is reconciled against another system.",
      "syntax_block": "Value = Round(number, places, RoundMode.Round15as10);",
      "syntax_block_ves": "Value = Round(number, places, RoundMode.Round15as10);",
      "parameters": "",
      "return_descr": "RoundMode.",
      "example": "Message(Round(1.25, 1));                          // 1.3\nMessage(Round(1.25, 1, RoundMode.Round15as10));   // 1.2\nMessage(Round(1.251, 1, RoundMode.Round15as10));  // 1.3",
      "availability": "Client, Server",
      "see_also": ["enum.RoundMode.Round15as10", "enum.RoundMode.Round15as20", "fn.Round"],
      "reviewed": false
    },
    {
      "id": "enum.RoundMode.Round15as10",
      "name_local": "Round15as10",
      "name_en": "Round15as10",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "RoundMode.Round15as10",
      "description": "An exact half goes towards zero: 1.5 becomes 1, -1.5 becomes -1. Past the half the number goes away from zero as usual: 1.51 and 1.6 become 2.",
      "syntax_block": "Round(number, places, RoundMode.Round15as10)",
      "parameters": "",
      "return_descr": "RoundMode.",
      "example": "Message(Round(1.5, 0, RoundMode.Round15as10));   // 1",
      "availability": "Client, Server",
      "see_also": ["enum.RoundMode", "fn.Round"],
      "reviewed": false
    },
    {
      "id": "enum.RoundMode.Round15as20",
      "name_local": "Round15as20",
      "name_en": "Round15as20",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "RoundMode.Round15as20",
      "description": "An exact half goes away from zero: 1.5 becomes 2, -1.5 becomes -2. The default when Round is given no rule.",
      "syntax_block": "Round(number, places, RoundMode.Round15as20)",
      "parameters": "",
      "return_descr": "RoundMode.",
      "example": "Message(Round(1.25, 1, RoundMode.Round15as20));   // 1.3",
      "availability": "Client, Server",
      "see_also": ["enum.RoundMode", "fn.Round"],
      "reviewed": false
    },
    {
      "id": "enum.Chars",
      "name_local": "Chars",
      "name_en": "Chars",
      "kind": "enum_type",
      "class_id": 391176189795626039,
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.CR, .FF, .LF, .NBSp, .Tab, .VTab",
      "description": "Characters a script cannot type in a string literal, by name. A member READS AS THE CHARACTER ITSELF: `\"a\" + Chars.LF + \"b\"` is two lines, three characters long, and `Asc(Chars.Tab)` is 9. The same characters are `Chr(code)`; the names say which one is meant.",
      "syntax_block": "Text = \"First line\" + Chars.LF + \"Second line\";",
      "syntax_block_ves": "Text = \"First line\" + Chars.LF + \"Second line\";",
      "parameters": "",
      "return_descr": "A one-character string.",
      "example": "Row = \"Paper\" + Chars.Tab + \"12\";\nText = \"Total:\" + Chars.CR + Chars.LF + \"12 pcs\";\nMessage(StrLineCount(Text));   // 2",
      "availability": "Client, Server",
      "see_also": ["enum.Chars.CR", "enum.Chars.FF", "enum.Chars.LF", "enum.Chars.NBSp", "enum.Chars.Tab", "enum.Chars.VTab", "fn.Chr", "fn.Asc", "fn.StrLineCount"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.CR",
      "name_local": "CR",
      "name_en": "CR",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.CR",
      "description": "Carriage return, code 13. Followed by LF it is the line break of text files written on Windows. StrLineCount and StrGetLine take the pair as one break, and a CR on its own as a break too.",
      "syntax_block": "Text = First + Chars.CR + Chars.LF + Second;",
      "parameters": "",
      "return_descr": "A one-character string.",
      "example": "Line = \"12 pcs\" + Chars.CR + Chars.LF;",
      "availability": "Client, Server",
      "see_also": ["enum.Chars", "enum.Chars.LF", "fn.StrLineCount"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.FF",
      "name_local": "FF",
      "name_en": "FF",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.FF",
      "description": "Form feed, code 12 - the page break of plain text sent to a printer.",
      "syntax_block": "Text = Page1 + Chars.FF + Page2;",
      "parameters": "",
      "return_descr": "A one-character string.",
      "example": "Text = \"Page 1\" + Chars.FF + \"Page 2\";",
      "availability": "Client, Server",
      "see_also": ["enum.Chars"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.LF",
      "name_local": "LF",
      "name_en": "LF",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.LF",
      "description": "Line feed, code 10 - the line break. StrGetLine and StrLineCount break the text on it.",
      "syntax_block": "Text = First + Chars.LF + Second;",
      "parameters": "",
      "return_descr": "A one-character string.",
      "example": "Message(\"Posted: 12\" + Chars.LF + \"Skipped: 3\");",
      "availability": "Client, Server",
      "see_also": ["enum.Chars", "enum.Chars.CR", "fn.StrGetLine", "fn.StrLineCount"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.NBSp",
      "name_local": "NBSp",
      "name_en": "NBSp",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.NBSp",
      "description": "Non-breaking space, code 160: a space a line is never broken at - between a number and its unit, or inside a number written with group separators. TrimAll does not take it for a space: replace it first when cleaning text that came from elsewhere.",
      "syntax_block": "Text = Amount + Chars.NBSp + \"EUR\";",
      "parameters": "",
      "return_descr": "A one-character string.",
      "example": "Clean = StrReplace(Imported, Chars.NBSp, \" \");",
      "availability": "Client, Server",
      "see_also": ["enum.Chars", "fn.StrReplace"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.Tab",
      "name_local": "Tab",
      "name_en": "Tab",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.Tab",
      "description": "Horizontal tab, code 9 - the column separator of tab-separated text.",
      "syntax_block": "Row = Item + Chars.Tab + Quantity;",
      "parameters": "",
      "return_descr": "A one-character string.",
      "example": "Fields = StrSplit(Line, Chars.Tab);",
      "availability": "Client, Server",
      "see_also": ["enum.Chars", "fn.StrSplit"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.VTab",
      "name_local": "VTab",
      "name_en": "VTab",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.VTab",
      "description": "Vertical tab, code 11. Rare in text; some exports use it for a line break inside a cell.",
      "syntax_block": "Text = First + Chars.VTab + Second;",
      "parameters": "",
      "return_descr": "A one-character string.",
      "example": "Clean = StrReplace(Cell, Chars.VTab, Chars.LF);",
      "availability": "Client, Server",
      "see_also": ["enum.Chars"],
      "reviewed": false
    }
  ]
}
