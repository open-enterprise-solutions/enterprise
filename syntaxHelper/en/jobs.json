      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJob.WaitForExecutionCompletion([timeout : number])",
      "description": "Waits for the job to end, at most the timeout in seconds; none or 0 waits for the end. A job still running when the timeout elapses is not an error: State says Active. Returns the job itself.",
      "syntax_block": "Job = Job.WaitForExecutionCompletion(60);",
      "parameters": "timeout - seconds to wait at most.",
      "return_descr": "BackgroundJob.",
      "example": "Job = Job.WaitForExecutionCompletion(60);\nif (Job.State = BackgroundJobState.Active) { Message(\"still running\"); }",
      "availability": "Server",
