{
  "format": "OES-HELP-1.0",
  "schema_version": 1,
  "locale": "en",
  "entries": [
    {
      "id": "kw.If",
      "name_local": "If",
      "name_en": "If",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "If <Expression> Then ... [ElsIf ... Then ...] [Else ...] EndIf",
      "description": "Conditional execution. Evaluates the boolean expression; runs the Then branch when true, otherwise an optional ElsIf branch with its own expression, otherwise an optional Else branch.",
      "syntax_block": "if (<Expression1>) {\n    // statements\n} elsif (<Expression2>) {\n    // statements\n} else {\n    // statements\n}",
      "parameters": "<Expression1>, <Expression2> — boolean expressions.",
      "return_descr": "",
      "example": "if (userInfo.IsAdmin) {\n    EnableAdminMenu();\n} else {\n    HideAdminMenu();\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Else",
        "kw.Elseif",
        "kw.While"
      ],
      "reviewed": true,
      "syntax_block_ves": "If <Expression1> Then\n    // statements\nElsIf <Expression2> Then\n    // statements\nElse\n    // statements\nEndIf",
      "example_ves": "If userInfo.IsAdmin Then\n    EnableAdminMenu();\nElse\n    HideAdminMenu();\nEndIf",
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Then",
      "name_local": "Then",
      "name_en": "Then",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Terminates the condition expression of an If / ElsIf branch. The body that follows runs only when the corresponding expression is true.",
      "syntax_block": "If <Expr> Then\n    // body\nEndIf;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.If",
        "kw.Else",
        "kw.Elseif",
        "kw.Endif"
      ],
      "reviewed": true,
      "modes": [
        "ves"
      ]
    },
    {
      "id": "kw.Else",
      "name_local": "Else",
      "name_en": "Else",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Branch executed when every preceding If / ElsIf condition was false.",
      "syntax_block": "if (<Expr>) {\n    // matched\n} else {\n    // fallback\n}",
      "syntax_block_ves": "If <Expr> Then\n    // matched\nElse\n    // fallback\nEndIf;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.If",
        "kw.Elseif",
        "kw.Endif"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Elseif",
      "name_local": "Elseif",
      "name_en": "Elseif",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Adds a chained condition to an If statement. Evaluated only if every earlier branch's condition was false.",
      "syntax_block": "if (A) {\n    // …\n} elsif (B) {\n    // …\n} elsif (C) {\n    // …\n}",
      "syntax_block_ves": "If A Then\n    // …\nElsIf B Then\n    // …\nElsIf C Then\n    // …\nEndIf;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.If",
        "kw.Else",
        "kw.Endif"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Endif",
      "name_local": "Endif",
      "name_en": "Endif",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Closes an If construct.",
      "syntax_block": "If <Expr> Then\n    // body\nEndIf;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.If"
      ],
      "reviewed": true,
      "modes": [
        "ves"
      ]
    },
    {
      "id": "kw.For",
      "name_local": "For",
      "name_en": "For",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Counted or iterator-based loop. Two forms: indexed (For <i> = <from> To <to> Do) and for-each (For Each <item> In <collection> Do).",
      "syntax_block": "// indexed\nfor (i = 1 To 10) {\n    // body\n}\n\n// for-each\nfor each (Item In Collection) {\n    // body\n}",
      "parameters": "",
      "return_descr": "",
      "example": "for each (Order In Customer.Orders) {\n    Total = Total + Order.Amount;\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Foreach",
        "kw.In",
        "kw.To",
        "kw.Break",
        "kw.Continue"
      ],
      "reviewed": true,
      "syntax_block_ves": "// indexed\nFor i = 1 To 10 Do\n    // body\nEndDo;\n\n// for-each\nFor Each Item In Collection Do\n    // body\nEndDo;",
      "example_ves": "For Each Order In Customer.Orders Do\n    Total = Total + Order.Amount;\nEndDo;",
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Foreach",
      "name_local": "Foreach",
      "name_en": "Foreach",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Loop modifier introducing for-each iteration over a collection.",
      "syntax_block": "Foreach (<Item> In <Collection>) {\n    // body\n}",
      "syntax_block_ves": "Foreach <Item> In <Collection> Do\n    // body\nEndDo;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.For",
        "kw.In",
        "kw.Do"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.To",
      "name_local": "To",
      "name_en": "To",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Upper bound (inclusive) of the indexed For loop.",
      "syntax_block": "for (i = 1 To 10) {\n    // body\n}",
      "syntax_block_ves": "For i = 1 To 10 Do … EndDo;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.For"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.In",
      "name_local": "In",
      "name_en": "In",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Marks the collection expression in a for-each loop.",
      "syntax_block": "Foreach (<Item> In <Collection>) {\n    // body\n}",
      "syntax_block_ves": "Foreach <Item> In <Collection> Do … EndDo;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.For",
        "kw.Foreach"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Do",
      "name_local": "Do",
      "name_en": "Do",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Opens the body of a While or For loop.",
      "syntax_block": "While <Cond> Do … EndDo;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.While",
        "kw.For",
        "kw.EndDo"
      ],
      "reviewed": true,
      "modes": [
        "ves"
      ]
    },
    {
      "id": "kw.EndDo",
      "name_local": "EndDo",
      "name_en": "EndDo",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Closes the body of a While or For loop.",
      "syntax_block": "While X Do\n    // …\nEndDo;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.While",
        "kw.For",
        "kw.Do"
      ],
      "reviewed": true,
      "modes": [
        "ves"
      ]
    },
    {
      "id": "kw.While",
      "name_local": "While",
      "name_en": "While",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Pre-test loop. Evaluates the condition before each iteration; runs the body while the condition is true.",
      "syntax_block": "while (<Condition>) {\n    // body\n}",
      "parameters": "",
      "return_descr": "",
      "example": "Counter = 0;\nwhile (Counter < 10) {\n    Counter = Counter + 1;\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.For",
        "kw.Break",
        "kw.Continue"
      ],
      "reviewed": true,
      "syntax_block_ves": "While <Condition> Do\n    // body\nEndDo;",
      "example_ves": "Counter = 0;\nWhile Counter < 10 Do\n    Counter = Counter + 1;\nEndDo;",
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.GoTo",
      "name_local": "GoTo",
      "name_en": "GoTo",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Unconditional jump to a labelled statement within the same scope. Use sparingly — a loop / function refactor is almost always clearer.",
      "syntax_block": "GoTo ~<Label>;\n…\n~<Label>:",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Not",
      "name_local": "Not",
      "name_en": "Not",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Logical negation.",
      "syntax_block": "Not <Expression>",
      "parameters": "",
      "return_descr": "",
      "example": "If Not User.IsLoggedIn Then\n    ShowLoginForm();\nEndIf;",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.And",
        "kw.Or"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.And",
      "name_local": "And",
      "name_en": "And",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Logical conjunction. Short-circuits: the right operand is not evaluated when the left is false.",
      "syntax_block": "<LeftExpr> And <RightExpr>",
      "parameters": "",
      "return_descr": "",
      "example": "If User.IsLoggedIn And User.Role = \"admin\" Then\n    ShowAdminPanel();\nEndIf;",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Or",
        "kw.Not"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Or",
      "name_local": "Or",
      "name_en": "Or",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Logical disjunction. Short-circuits: the right operand is not evaluated when the left is true.",
      "syntax_block": "<LeftExpr> Or <RightExpr>",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.And",
        "kw.Not"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Procedure",
      "name_local": "Procedure",
      "name_en": "Procedure",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Declares a procedure — a callable unit that performs work but does not return a value. Use Function instead when the caller needs a result.",
      "syntax_block": "[Public] Procedure <Name>([Val] <Param1>, [Val] <Param2>, …) {\n    // body\n}",
      "parameters": "<Name> — identifier. Val — pass-by-value modifier. Public — make the procedure callable from other modules (written before the declaration).",
      "return_descr": "",
      "example": "Public Procedure LogMessage(Val Text) {\n    Message(Text);\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Function",
        "kw.Return",
        "kw.Public",
        "kw.Val"
      ],
      "reviewed": true,
      "syntax_block_ves": "[Public] Procedure <Name>([Val] <Param1>, [Val] <Param2>, …)\n    // body\nEndProcedure",
      "example_ves": "Public Procedure LogMessage(Val Text)\n    Message(Text);\nEndProcedure",
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.EndProcedure",
      "name_local": "EndProcedure",
      "name_en": "EndProcedure",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Closes a procedure body. Execution returns to the caller when control reaches EndProcedure.",
      "syntax_block": "Procedure Demo()\n    // …\nEndProcedure",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Procedure"
      ],
      "reviewed": true,
      "modes": [
        "ves"
      ]
    },
    {
      "id": "kw.Function",
      "name_local": "Function",
      "name_en": "Function",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Declares a function — a callable that returns a value via Return. Functions are interchangeable with procedures everywhere except as expression sources.",
      "syntax_block": "[Public] Function <Name>([Val] <Param1>, …) {\n    // body\n    Return <Value>;\n}",
      "parameters": "<Name> — identifier. Val — pass-by-value modifier. Public — make the function callable from other modules (written before the declaration).",
      "return_descr": "Whatever the Return statement produces.",
      "example": "Public Function Sum(Val A, Val B) {\n    Return A + B;\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Procedure",
        "kw.Return",
        "kw.Public"
      ],
      "reviewed": true,
      "syntax_block_ves": "[Public] Function <Name>([Val] <Param1>, …)\n    // body\n    Return <Value>;\nEndFunction",
      "example_ves": "Public Function Sum(Val A, Val B)\n    Return A + B;\nEndFunction",
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.EndFunction",
      "name_local": "EndFunction",
      "name_en": "EndFunction",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Closes a function body. Reaching EndFunction without an explicit Return makes the function yield Undefined.",
      "syntax_block": "Function Demo()\n    Return 42;\nEndFunction",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Function",
        "kw.Return",
        "kw.Undefined"
      ],
      "reviewed": true,
      "modes": [
        "ves"
      ]
    },
    {
      "id": "kw.Public",
      "name_local": "Public",
      "name_en": "Public",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Access modifier: makes a procedure, function, or module-level variable visible to other modules. Written BEFORE the declaration. Replaces the former Export keyword, which no longer exists.",
      "syntax_block": "Public Procedure DoWork() {\n    // body\n}",
      "syntax_block_ves": "Public Procedure DoWork()\n    // body\nEndProcedure",
      "parameters": "",
      "return_descr": "",
      "example": "Public Var Counter;\n\nPublic Function Read() {\n    Return Counter;\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Private",
        "kw.Protected",
        "kw.Procedure",
        "kw.Function",
        "kw.Var"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Private",
      "name_local": "Private",
      "name_en": "Private",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Access modifier: the symbol is visible only inside its own module. This is the default, so Private is written to state the intent explicitly.",
      "syntax_block": "Private Procedure Helper() {\n    // body\n}",
      "syntax_block_ves": "Private Procedure Helper()\n    // body\nEndProcedure",
      "parameters": "",
      "return_descr": "",
      "example": "Private Var cache;\n\nPrivate Function Prepare() {\n    Return cache;\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Public",
        "kw.Protected",
        "kw.Var"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Protected",
      "name_local": "Protected",
      "name_en": "Protected",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Access modifier: the symbol is visible to the module's children — an object module exposes it to the forms of that object — but not to the whole configuration.",
      "syntax_block": "Protected Procedure Recalculate() {\n    // visible to this object's forms\n}",
      "syntax_block_ves": "Protected Procedure Recalculate()\n    // visible to this object's forms\nEndProcedure",
      "parameters": "",
      "return_descr": "",
      "example": "Protected Var lastTotal;\n\nProtected Function Total() {\n    Return lastTotal;\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Public",
        "kw.Private",
        "kw.Var"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Val",
      "name_local": "Val",
      "name_en": "Val",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Pass-by-value parameter modifier. Without Val the parameter is bound by reference and assignments inside the callee mutate the caller's binding; with Val a local copy is taken.",
      "syntax_block": "Procedure Demo(Val ReadOnlyParam, MutableParam) {\n    // ReadOnlyParam is a copy of the caller's value.\n    // MutableParam writes back into the caller's variable.\n}",
      "syntax_block_ves": "Procedure Demo(Val ReadOnlyParam, MutableParam)\n    // ReadOnlyParam is a copy of the caller's value.\n    // MutableParam writes back into the caller's variable.\nEndProcedure",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Procedure",
        "kw.Function"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Return",
      "name_local": "Return",
      "name_en": "Return",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Exits the current procedure or function. Inside a function may carry a result expression.",
      "syntax_block": "Return;                 // exit procedure\nReturn <Expression>;    // exit function with result",
      "parameters": "",
      "return_descr": "",
      "example": "Function Sign(Val X)\n    If X < 0 Then Return -1; EndIf;\n    If X > 0 Then Return 1;  EndIf;\n    Return 0;\nEndFunction",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Function",
        "kw.Procedure"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Try",
      "name_local": "Try",
      "name_en": "Try",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Begins an exception-handling block. Code inside is monitored; a raised exception transfers control to the Except branch.",
      "syntax_block": "try {\n    // protected body\n} except {\n    // handler — runs on any raised exception\n}",
      "parameters": "",
      "return_descr": "",
      "example": "try {\n    Result = ParseNumber(UserInput);\n} except {\n    Message(\"Not a valid number: \" + ErrorDescription());\n}",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Except",
        "kw.Raise"
      ],
      "reviewed": true,
      "syntax_block_ves": "Try\n    // protected body\nExcept\n    // handler — runs on any raised exception\nEndTry;",
      "example_ves": "Try\n    Result = ParseNumber(UserInput);\nExcept\n    Message(\"Not a valid number: \" + ErrorDescription());\nEndTry;",
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Except",
      "name_local": "Except",
      "name_en": "Except",
      "kind": "keyword",
      "category_keys": [
        "common_lang",
        "control_flow"
      ],
      "signature": "",
      "description": "Opens the handler branch of a Try / Except construct. Runs when the protected body raises an exception.",
      "syntax_block": "try {\n    // …\n} except {\n    // recovery\n}",
      "syntax_block_ves": "Try\n    // …\nExcept\n    // recovery\nEndTry;",
      "parameters": "",
      "return_descr": "",
      "example": "",
      "availability": "Designer, codeRunner, daemon, wenterprise-server",
      "see_also": [
        "kw.Try",
        "kw.Endtry",
        "kw.Raise"
      ],
      "reviewed": true,
      "modes": [
        "ves",
        "ces"
      ]
    },
    {
      "id": "kw.Endtry",
      "name_local": "Endtry",
