{
  "format": "OES-HELP-1.0",
  "schema_version": 1,
  "locale": "en",
  "entries": [
    {
      "id": "fn.SetApplicationCaption",
      "name_local": "SetApplicationCaption",
      "name_en": "SetApplicationCaption",
      "kind": "system_function",
      "category_keys": ["global_context", "global_functions"],
      "signature": "SetApplicationCaption(title)",
      "description": "Sets the caption GetApplicationCaption returns, and the window title when a window is open."
    },
    {
      "id": "fn.GetApplicationCaption",
      "name_local": "GetApplicationCaption",
      "name_en": "GetApplicationCaption",
      "kind": "system_function",
      "category_keys": ["global_context", "global_functions"],
      "signature": "GetApplicationCaption()",
      "description": "String. The caption last passed to SetApplicationCaption. Empty until then."
    },
    {
      "id": "fn.ShowMessageBox",
      "name_local": "ShowMessageBox",
      "name_en": "ShowMessageBox",
      "kind": "system_function",
      "category_keys": ["global_context", "global_functions"],
      "signature": "ShowMessageBox(text)",
      "description": "Shows the text the way Alert does. With no window open, nothing is shown."
    }
  ]
}
