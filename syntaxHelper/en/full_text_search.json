    {
      "id": "cls.FullTextSearch.CreateList",
      "name_local": "CreateList",
      "name_en": "CreateList",
      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "full_text_search"
      ],
      "signature": "FullTextSearch.CreateList(searchString : string = \"\", portionSize : number = 20) : FullTextSearchList",
      "description": "A search, not run yet: FirstPart runs it. The text is plain words, with no operators. A record is found when it holds every word - each as the beginning of an indexed word (whe finds wheel) or within one letter in five of one (wheal, wheell). A size or an article written with a dot, a slash or a comma between digits (205/55, 1.6) is one word. Case does not matter.",
      "syntax_block": "List = FullTextSearch.CreateList(searchString, portionSize);",
      "parameters": "searchString - the words to find.\nportionSize - how many records a part holds. Left out - 20.",
      "return_descr": "FullTextSearchList.",
      "example": "List = FullTextSearch.CreateList(\"wheel 205/55\", 20);\nList.FirstPart();\nMessage(List.TotalCount());",
      "availability": "Server",
      "see_also": [
        "cls.FullTextSearch",
        "cls.FullTextSearchList",
        "cls.FullTextSearchList.FirstPart"
      ],
      "reviewed": false
    },
    {
      "id": "cls.FullTextSearchList",
      "name_local": "FullTextSearchList",
      "name_en": "FullTextSearchList",
      "kind": "collection",
      "category_keys": [
        "global_context",
        "runtime",
        "full_text_search"
      ],
      "signature": "FullTextSearchList",
      "description": "A search and its parts, made by FullTextSearch.CreateList. Nothing is searched until FirstPart; then the found records are read a part at a time, best ranked first - a record where the words stand more often comes higher, an exact or beginning match counting twice a misspelt one.\n\nWHAT THE PERSON MAY SEE: only objects they may read, and of their records only those the row-level access lets them read. TotalCount counts after that filter, so it is the person's own total.",
      "syntax_block": "List = FullTextSearch.CreateList(\"wheel\");",
      "parameters": "",
      "return_descr": "",
      "example": "List = FullTextSearch.CreateList(\"wheel\", 10);\nList.FirstPart();\nwhile (true) {\n    for (i = 0; i < List.Count(); i++) {\n        Message(List.Get(i).Presentation);\n    }\n    if (List.StartIndex() + List.Count() >= List.TotalCount()) {\n        break;\n    }\n    List.NextPart();\n}",
      "availability": "Server",
      "see_also": [
        "cls.FullTextSearchList.FirstPart",
        "cls.FullTextSearchList.NextPart",
        "cls.FullTextSearchList.PreviousPart",
        "cls.FullTextSearchList.Count",
        "cls.FullTextSearchList.TotalCount",
        "cls.FullTextSearchList.StartIndex",
        "cls.FullTextSearchList.Get",
        "cls.FullTextSearchList.SearchString",
        "cls.FullTextSearchList.PortionSize",
        "cls.FullTextSearchItem",
        "cls.FullTextSearch.CreateList"
      ],
      "reviewed": false
    },
