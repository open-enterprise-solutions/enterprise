        "global_context",
        "runtime",
        "full_text_search"
      ],
      "signature": "FullTextSearchMode.Disable",
      "description": "Full-text search is off - also what a base where nobody switched it on answers.",
      "syntax_block": "FullTextSearch.SetFullTextSearchMode(FullTextSearchMode.Disable);",
      "parameters": "",
      "return_descr": "FullTextSearchMode.",
      "example": "FullTextSearch.SetFullTextSearchMode(FullTextSearchMode.Disable);",
