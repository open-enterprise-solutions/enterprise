        "value_types",
        "runtime",
        "forms"
      ],
      "signature": "ButtonView.Hyperlink",
      "description": "A hyperlink: no face and no frame, the caption underlined in a link's colour, a hand over it. A client older than protocol 8 draws a button.",
      "syntax_block": "Controls.Button1.View = ButtonView.Hyperlink;",
