    {
      "id": "enum.PictureLocation.Tile",
      "name_local": "Tile",
      "name_en": "Tile",
      "kind": "system_enum",
      "category_keys": [
        "value_types",
        "runtime",
        "forms"
      ],
      "signature": "PictureLocation.Tile",
      "description": "A button for a finger: the picture large over the caption, the button's Note under them in a smaller face (a price, a count, a state), the whole filling what its sizer gives it. Put tiles in a grid sizer for a panel of them. A client older than protocol 8 shows the picture on the left and no note.",
      "syntax_block": "Controls.Button1.PictureLocation = PictureLocation.Tile;",
      "parameters": "",
      "return_descr": "PictureLocation.",
      "example": "Controls.Button1.PictureLocation = PictureLocation.Tile;",
