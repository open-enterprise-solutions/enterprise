      "id": "enum.ButtonView",
      "name_local": "ButtonView",
      "name_en": "ButtonView",
      "kind": "enum_type",
      "class_id": 431239117940110366,
      "category_keys": [
        "value_types",
        "runtime",
        "forms"
      ],
      "signature": "ButtonView.Button, .Hyperlink",
      "description": "How a button is drawn: a button, or a hyperlink - the same button with no face and no frame, its caption underlined. A button's View property holds a member, written ButtonView.<Name>. Pressed the same way either way; its picture, where the picture stands and its command do not change.\n\nA script reads and sets it on a button of the form: `Controls.Button1.View = ButtonView.Hyperlink;`.",
      "syntax_block": "Controls.Button1.View = ButtonView.Hyperlink;",
      "syntax_block_ves": "Controls.Button1.View = ButtonView.Hyperlink;",
      "parameters": "",
      "return_descr": "ButtonView.",
      "example": "Controls.Button1.View = ButtonView.Hyperlink;",
      "availability": "Thin client, Server",
      "see_also": [
        "enum.ButtonView.Button",
        "enum.ButtonView.Hyperlink",
        "enum.PictureLocation"
      ],
      "reviewed": false
    },
    {
      "id": "enum.ButtonView.Button",
