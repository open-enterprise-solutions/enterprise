    {
      "id": "enum.ButtonRepresentation",
      "name_local": "ButtonRepresentation",
      "name_en": "ButtonRepresentation",
      "kind": "enum_type",
      "class_id": 398331834571618557,
      "category_keys": [
        "value_types",
        "runtime",
        "forms"
      ],
      "signature": "ButtonRepresentation.Auto, .Text, .Picture, .PictureAndText, .Tile",
      "description": "What a button shows: its caption, its picture, both, or a tile. A button's Representation property holds a member, written ButtonRepresentation.<Name>. It has the four members a column, a page and a command bar item also show - Auto, Text, Picture, PictureAndText, under the same numbers - and Tile, which only a button has.\n\nA script reads and sets it on a button of the form: `Controls.Button1.Representation = ButtonRepresentation.Tile;`. The shared enumeration Representation is another type: a member of it set on a button's Representation is taken by its number, but compared with it answers False.",
      "syntax_block": "Controls.Button1.Representation = ButtonRepresentation.Tile;",
      "syntax_block_ves": "Controls.Button1.Representation = ButtonRepresentation.Tile;",
      "parameters": "",
      "return_descr": "ButtonRepresentation.",
      "example": "Controls.Button1.Representation = ButtonRepresentation.Tile;\nControls.Button1.Note = \"12\";",
      "availability": "Thin client, Server",
      "see_also": [
        "enum.ButtonRepresentation.Auto",
        "enum.ButtonRepresentation.Text",
        "enum.ButtonRepresentation.Picture",
        "enum.ButtonRepresentation.PictureAndText",
        "enum.ButtonRepresentation.Tile"
      ],
      "reviewed": false
    },
    {
