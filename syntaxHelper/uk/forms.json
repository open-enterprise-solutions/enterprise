    {
      "id": "enum.PictureLocation",
      "name_local": "PictureLocation",
      "name_en": "PictureLocation",
      "kind": "enum_type",
      "class_id": 402851473462030947,
      "category_keys": [
        "value_types",
        "runtime",
        "forms"
      ],
      "signature": "PictureLocation.Auto, .Left, .Right, .Tile",
      "description": "Де стоїть картинка кнопки: там, куди її ставить кнопка, ліворуч чи праворуч від напису, або плиткою. Властивість кнопки PictureLocation зберігає значення, записується PictureLocation.<Ім'я>. Що показує кнопка - напис, картинку чи те й інше, - вирішує її Representation, як у будь-якого елемента.\n\nСкрипт читає й задає його в кнопки форми: `Controls.Button1.PictureLocation = PictureLocation.Tile;`.",
      "syntax_block": "Controls.Button1.PictureLocation = PictureLocation.Tile;",
      "syntax_block_ves": "Controls.Button1.PictureLocation = PictureLocation.Tile;",
      "parameters": "",
      "return_descr": "PictureLocation.",
      "example": "Controls.Button1.PictureLocation = PictureLocation.Tile;\nControls.Button1.Note = \"12\";",
      "availability": "Thin client, Server",
      "see_also": [
        "enum.PictureLocation.Auto",
        "enum.PictureLocation.Left",
        "enum.PictureLocation.Right",
        "enum.PictureLocation.Tile"
      ],
      "reviewed": false
    },
