      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJob.Begin",
      "description": "Коли запуск почався. Лише читання.",
      "syntax_block": "Message(Job.Begin);",
      "parameters": "",
      "return_descr": "Дата.",
      "example": "Message(Job.Begin);",
      "availability": "Сервер",
      "see_also": [
        "cls.BackgroundJob"
      ],
      "reviewed": false
    },
    {
