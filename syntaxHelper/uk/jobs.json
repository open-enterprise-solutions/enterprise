    {
      "id": "cls.BackgroundJob.Wait",
      "name_local": "Wait",
      "name_en": "Wait",
      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJob.Wait([timeoutMs : number])",
