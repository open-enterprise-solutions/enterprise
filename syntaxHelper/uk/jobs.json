      ],
      "reviewed": false
    },
    {
      "id": "cls.BackgroundJob.IsComplete",
      "name_local": "IsComplete",
      "name_en": "IsComplete",
      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJob.IsComplete()",
      "description": "Істина, коли запуск завершився, хоч би як він завершився.",
      "syntax_block": "Done = Job.IsComplete();",
      "parameters": "",
      "return_descr": "Булеве.",
      "example": "if (Job.IsComplete()) { Message(Job.State); }",
      "availability": "Сервер",
