    {
      "id": "cls.BackgroundJob.Description",
      "name_local": "Description",
      "name_en": "Description",
      "kind": "property",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJob.Description",
      "description": "Що це за запуск, як його читає людина: четвертий аргумент RunBackground або ім'я регламентного завдання, чий це прохід. Лише читання.",
      "syntax_block": "Message(Job.Description);",
      "parameters": "",
      "return_descr": "Рядок.",
      "example": "Message(Job.Description);",
      "availability": "Сервер",
      "see_also": [
        "cls.BackgroundJob"
      ],
      "reviewed": false
    },
    {
      "id": "cls.BackgroundJob.MethodName",
      "name_local": "MethodName",
      "name_en": "MethodName",
