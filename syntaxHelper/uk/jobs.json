      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJob.MethodName",
      "description": "Який метод виконується — Ім'яМодуля.Ім'яМетоду; порожньо в проходу регламентного завдання. Лише читання.",
      "syntax_block": "Message(Job.MethodName);",
      "parameters": "",
      "return_descr": "Рядок.",
      "example": "Message(Job.MethodName);",
      "availability": "Сервер",
      "see_also": [
        "cls.BackgroundJob"
      ],
      "reviewed": false
    },
    {
      "id": "cls.BackgroundJob.UUID",
