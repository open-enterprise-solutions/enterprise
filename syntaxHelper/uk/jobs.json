      "name_local": "End",
      "name_en": "End",
      "kind": "property",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJob.End",
      "description": "Коли запуск завершився; порожня дата, поки він триває. Лише читання.",
      "syntax_block": "Message(Job.End);",
      "parameters": "",
      "return_descr": "Дата.",
      "example": "Message(Job.End);",
      "availability": "Сервер",
      "see_also": [
        "cls.BackgroundJob"
      ],
      "reviewed": false
    },
    {
      "id": "cls.BackgroundJob.Key",
      "name_local": "Key",
      "name_en": "Key",
      "kind": "property",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJob.Key",
      "description": "Ключ, з яким запуск розпочато, — третій аргумент RunBackground; порожньо, якщо не вказано. Лише читання.",
      "syntax_block": "Message(Job.Key);",
      "parameters": "",
      "return_descr": "Рядок.",
      "example": "Message(Job.Key);",
      "availability": "Сервер",
      "see_also": [
        "cls.BackgroundJob",
        "fn.RunBackground"
      ],
      "reviewed": false
