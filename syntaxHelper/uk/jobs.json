  "entries": [
    {
      "id": "cls.ScheduledJobs",
      "name_local": "ScheduledJobs",
      "name_en": "ScheduledJobs",
      "kind": "collection",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "ScheduledJobs.Predefined | ScheduledJobs.Parameterized.<Name>",
      "description": "Регламентні завдання конфігурації — два види, кожен за своєю розвилкою. Predefined — усі визначені завдання як колекція JobSettings: оголошені в конфігураторі, існують один раз, живі налаштування зберігаються в базі. Parameterized.<Name> — менеджер параметризованого завдання: його завдання — рядки його таблиці, вибираються, шукаються й виконуються як у довідника.",
      "syntax_block": "for each Job in ScheduledJobs.Predefined { }",
      "parameters": "",
      "return_descr": "",
      "example": "for each Job in ScheduledJobs.Predefined {\n    Message(Job.Name + \": \" + Job.Schedule);\n}",
      "availability": "Сервер",
      "see_also": [
        "cls.JobSettings",
        "mgr.ParameterizedJob.LastJob",
        "cls.BackgroundJobs"
      ],
      "reviewed": false
    },
    {
      "id": "cls.JobSettings",
      "name_local": "JobSettings",
      "name_en": "JobSettings",
      "kind": "collection",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "JobSettings",
      "description": "Живі налаштування одного визначеного завдання — елемент ScheduledJobs.Predefined. Через New не створюється. Завдання, для якого в базі ще немає налаштувань, читається так, як оголошено. Write зберігає вимикач і розклад у базі й одразу застосовує їх до робочого розкладу.",
      "syntax_block": "for each Job in ScheduledJobs.Predefined { }",
      "parameters": "",
      "return_descr": "",
      "example": "for each Job in ScheduledJobs.Predefined {\n    if (Job.Active and Job.Schedule.Interval < 60) {\n        Job.Active = False;\n        Job.Write();\n    }\n}",
      "availability": "Сервер",
      "see_also": [
        "cls.ScheduledJobs",
        "cls.JobSettings.Write",
        "cls.JobSettings.LastJob"
      ],
      "reviewed": false
    },
    {
      "id": "cls.JobSettings.Name",
      "name_local": "Name",
      "name_en": "Name",
      "kind": "property",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "JobSettings.Name",
      "description": "Ім'я завдання, як його оголошує конфігурація. Лише читання.",
      "syntax_block": "Message(Job.Name);",
      "parameters": "",
      "return_descr": "Рядок.",
      "example": "Message(Job.Name);",
      "availability": "Сервер",
      "see_also": [
        "cls.JobSettings"
      ],
      "reviewed": false
    },
    {
      "id": "cls.JobSettings.Active",
      "name_local": "Active",
      "name_en": "Active",
      "kind": "property",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "JobSettings.Active",
      "description": "Чи запускає завдання розклад. Вимкнене завдання все одно можна запустити вручну через Execute. Зберігається методом Write.",
      "syntax_block": "Job.Active = False;",
      "parameters": "",
      "return_descr": "Булеве.",
      "example": "Job.Active = False;\nJob.Write();",
      "availability": "Сервер",
      "see_also": [
        "cls.JobSettings",
        "cls.JobSettings.Write"
      ],
      "reviewed": false
    },
    {
      "id": "cls.JobSettings.Schedule",
      "name_local": "Schedule",
      "name_en": "Schedule",
      "kind": "property",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "JobSettings.Schedule",
      "description": "Коли виконується завдання, значенням JobSchedule. Під час читання віддається копія: змініть її, присвойте назад, потім Write. Усе, крім JobSchedule, відхиляється.",
      "syntax_block": "Job.Schedule = Schedule;",
      "parameters": "",
      "return_descr": "JobSchedule.",
      "example": "Schedule = Job.Schedule;\nSchedule.Interval = 600;\nJob.Schedule = Schedule;\nJob.Write();",
      "availability": "Сервер",
      "see_also": [
        "cls.JobSettings",
        "cls.JobSettings.NextRun"
      ],
      "reviewed": false
    },
    {
      "id": "cls.JobSettings.LastRun",
      "name_local": "LastRun",
      "name_en": "LastRun",
      "kind": "property",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "JobSettings.LastRun",
      "description": "Коли завдання востаннє виконувалося на цій базі, будь-яким процесом; порожня дата, якщо жодного разу. Лише читання.",
      "syntax_block": "When = Job.LastRun;",
      "parameters": "",
      "return_descr": "Дата.",
      "example": "Message(Job.LastRun);",
      "availability": "Сервер",
      "see_also": [
        "cls.JobSettings",
        "cls.JobSettings.LastJob",
        "cls.JobSettings.Computer"
      ],
      "reviewed": false
    },
    {
      "id": "cls.JobSettings.LastJob",
      "name_local": "LastJob",
      "name_en": "LastJob",
      "kind": "property",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "JobSettings.LastJob",
      "description": "Останній прохід завдання в цьому застосунку, значенням BackgroundJob — його State, Begin, End і Error(). Undefined, якщо тут проходів не було; коли завдання виконувалося будь-де — LastRun. Прохід, який натомість узяв інший процес, тут сліду не лишає. Лише читання.",
      "syntax_block": "Last = Job.LastJob;",
      "parameters": "",
      "return_descr": "BackgroundJob або Undefined.",
      "example": "Last = Job.LastJob;\nif (Last <> Undefined and Last.State = BackgroundJobState.Failed) { Message(Last.Error()); }",
      "availability": "Сервер",
      "see_also": [
        "cls.JobSettings",
        "cls.BackgroundJob",
        "mgr.ParameterizedJob.LastJob"
      ],
      "reviewed": false
    },
    {
      "id": "cls.JobSettings.Computer",
      "name_local": "Computer",
      "name_en": "Computer",
      "kind": "property",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "JobSettings.Computer",
      "description": "На якому комп'ютері завдання виконувалося востаннє. Лише читання.",
      "syntax_block": "Message(Job.Computer);",
      "parameters": "",
      "return_descr": "Рядок.",
      "example": "Message(Job.Name + \": \" + Job.Computer);",
      "availability": "Сервер",
      "see_also": [
        "cls.JobSettings",
        "cls.JobSettings.LastRun"
      ],
      "reviewed": false
    },
    {
      "id": "cls.JobSettings.NextRun",
      "name_local": "NextRun",
      "name_en": "NextRun",
      "kind": "property",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "JobSettings.NextRun",
      "description": "Коли завдання виконається наступного разу — обчислюється з розкладу й останнього запуску під час кожного читання, ніде не зберігається. Лише читання.",
      "syntax_block": "Message(Job.NextRun);",
      "parameters": "",
      "return_descr": "Дата.",
      "example": "Message(Job.Name + \": \" + Job.NextRun);",
      "availability": "Сервер",
      "see_also": [
        "cls.JobSettings",
        "cls.JobSettings.Schedule"
      ],
      "reviewed": false
    },
    {
      "id": "cls.JobSettings.Read",
      "name_local": "Read",
      "name_en": "Read",
      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "JobSettings.Read()",
      "description": "Перечитує налаштування з бази — їх міг змінити інший сеанс. Хибність, якщо в базі для цього завдання налаштувань ще немає: тоді завдання читається так, як оголошено.",
      "syntax_block": "Job.Read();",
      "parameters": "",
      "return_descr": "Булеве.",
      "example": "Job.Read();\nMessage(Job.Active);",
      "availability": "Сервер",
      "see_also": [
        "cls.JobSettings",
        "cls.JobSettings.Write"
      ],
      "reviewed": false
    },
    {
      "id": "cls.JobSettings.Write",
      "name_local": "Write",
      "name_en": "Write",
      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "JobSettings.Write()",
      "description": "Зберігає Active і Schedule у базі й одразу застосовує їх до робочого розкладу. Якщо база їх не прийняла, виникає виняток — на незбережене налаштування не відповідають Істиною.",
      "syntax_block": "Job.Write();",
      "parameters": "",
      "return_descr": "Булеве.",
      "example": "Job.Active = True;\nJob.Write();",
      "availability": "Сервер",
      "see_also": [
        "cls.JobSettings",
        "cls.JobSettings.Read"
      ],
      "reviewed": false
    },
    {
      "id": "cls.JobSettings.Execute",
      "name_local": "Execute",
      "name_en": "Execute",
      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "JobSettings.Execute()",
      "description": "Запускає завдання зараз, хай що кажуть його розклад і вимикач. Хибність, якщо завдання не зареєстроване в цьому застосунку або вже виконується.",
      "syntax_block": "Job.Execute();",
      "parameters": "",
      "return_descr": "Булеве.",
      "example": "if (Job.Execute()) { Message(\"запущено\"); }",
      "availability": "Сервер",
      "see_also": [
        "cls.JobSettings",
        "cls.JobSettings.LastJob"
      ],
      "reviewed": false
    },
    {
      "id": "mgr.ParameterizedJob.LastJob",
      "name_local": "LastJob",
      "name_en": "LastJob",
      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "ScheduledJobs.Parameterized.<Name>.LastJob(job : reference)",
      "description": "Останній прохід одного рядка завдання в цьому застосунку, значенням BackgroundJob — та сама відповідь, що дає LastJob визначеного завдання. Undefined, якщо проходів цього рядка тут не було. Потрібне право на читання завдання.",
      "syntax_block": "Last = ScheduledJobs.Parameterized.Exchange.LastJob(Row);",
      "parameters": "job — посилання на рядок цього завдання.",
      "return_descr": "BackgroundJob або Undefined.",
      "example": "Last = ScheduledJobs.Parameterized.Exchange.LastJob(Row);\nif (Last <> Undefined and Last.State = BackgroundJobState.Failed) { Message(Last.Error()); }",
      "availability": "Сервер",
      "see_also": [
        "cls.ScheduledJobs",
        "cls.JobSettings.LastJob",
        "cls.BackgroundJob"
      ],
      "reviewed": false
    },
    {
      "id": "cls.BackgroundJobs",
      "name_local": "BackgroundJobs",
      "name_en": "BackgroundJobs",
      "kind": "collection",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJobs",
      "description": "Де знову знаходяться запуски застосунку: кожне фонове завдання, запущене RunBackground, і кожен прохід регламентного завдання — поки він триває і серед останніх 256 після завершення. Сам нічого не запускає — завдання запускається через RunBackground.",
      "syntax_block": "Jobs = BackgroundJobs.GetBackgroundJobs(Filter);",
      "parameters": "",
      "return_descr": "",
      "example": "Job = RunBackground(\"Exchange.Upload\", New Array(), \"upload\", \"Вивантаження на склад\");\nId = Job.UUID;\n// …пізніше або з іншого сеансу\nJob = BackgroundJobs.FindByUUID(Id);",
      "availability": "Сервер",
      "see_also": [
        "cls.BackgroundJob",
        "cls.BackgroundJobs.GetBackgroundJobs",
        "cls.BackgroundJobs.FindByUUID",
        "fn.RunBackground"
      ],
      "reviewed": false
    },
    {
      "id": "cls.BackgroundJobs.GetBackgroundJobs",
      "name_local": "GetBackgroundJobs",
      "name_en": "GetBackgroundJobs",
      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJobs.GetBackgroundJobs([filter : Structure])",
      "description": "Запуски, від старих до нових, Масивом BackgroundJob. Відбір називає властивості BackgroundJob: State, Key, Description, MethodName і UUID порівнюються на рівність; Begin лишає запуски, розпочаті не раніше нього, End — завершені не пізніше нього. Ім'я, яке не є властивістю BackgroundJob, відхиляється із зазначенням цього імені.",
      "syntax_block": "Jobs = BackgroundJobs.GetBackgroundJobs(Filter);",
      "parameters": "filter — Структура з властивостей вище; якщо не вказано — усі запуски.",
      "return_descr": "Масив BackgroundJob.",
      "example": "Running = BackgroundJobs.GetBackgroundJobs(New Structure(\"Key, State\", \"upload\", BackgroundJobState.Active));",
      "availability": "Сервер",
      "see_also": [
        "cls.BackgroundJobs",
        "cls.BackgroundJob"
      ],
      "reviewed": false
    },
    {
      "id": "cls.BackgroundJobs.FindByUUID",
      "name_local": "FindByUUID",
      "name_en": "FindByUUID",
      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJobs.FindByUUID(uuid : UUID | string)",
      "description": "Запуск із цим UUID або Undefined — давно завершений запуск відпускається. Значення, яке не є UUID, відхиляється.",
      "syntax_block": "Job = BackgroundJobs.FindByUUID(Id);",
      "parameters": "uuid — UUID або його текст.",
      "return_descr": "BackgroundJob або Undefined.",
      "example": "Job = BackgroundJobs.FindByUUID(Id);\nif (Job <> Undefined and Job.State = BackgroundJobState.Active) { Job.Cancel(); }",
      "availability": "Сервер",
      "see_also": [
        "cls.BackgroundJobs",
        "cls.BackgroundJob.UUID"
      ],
      "reviewed": false
    },
    {
      "id": "cls.BackgroundJob",
      "name_local": "BackgroundJob",
      "name_en": "BackgroundJob",
      "kind": "collection",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJob",
      "description": "Один запуск — розпочатий RunBackground або прохід регламентного завдання (LastJob). Через New не створюється. Якщо відпустити значення, нічого не зупиниться: запуск допрацює сам.",
      "syntax_block": "Job = RunBackground(\"Totals.Recalculate\", New Array());",
      "parameters": "",
      "return_descr": "",
      "example": "Job = RunBackground(\"Totals.Recalculate\", New Array());\nJob.Wait(30000);\nif (Job.State = BackgroundJobState.Failed) { Message(Job.Error()); }",
      "availability": "Сервер",
      "see_also": [
        "cls.BackgroundJobs",
        "enum.BackgroundJobState",
        "fn.RunBackground"
      ],
      "reviewed": false
    },
    {
      "id": "cls.BackgroundJob.State",
      "name_local": "State",
      "name_en": "State",
      "kind": "property",
      "category_keys": [
        "global_context",
        "runtime",
        "jobs"
      ],
      "signature": "BackgroundJob.State",
      "description": "Де перебуває запуск: Active, поки триває, потім Completed, Failed або Cancelled. Лише читання.",
      "syntax_block": "if (Job.State = BackgroundJobState.Active) { Job.Cancel(); }",
      "parameters": "",
      "return_descr": "BackgroundJobState.",
      "example": "if (Job.State = BackgroundJobState.Active) { Job.Cancel(); }",
      "availability": "Сервер",
      "see_also": [
        "cls.BackgroundJob",
        "enum.BackgroundJobState"
      ],
      "reviewed": false
    },
    {
