        "full_text_search"
      ],
      "signature": "FullTextSearch.UpdateDate() : date",
      "description": "Коли індекс востаннє було приведено в актуальний стан. Доки платформа індекс не веде — порожня дата: жодного разу.",
      "syntax_block": "Updated = FullTextSearch.UpdateDate();",
      "parameters": "",
      "return_descr": "Дата.",
      "example": "Message(FullTextSearch.UpdateDate());",
      "availability": "Сервер",
