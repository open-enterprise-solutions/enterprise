  "entries": [
    {
      "id": "cls.FullTextSearch",
      "name_local": "FullTextSearch",
      "name_en": "FullTextSearch",
      "kind": "collection",
      "category_keys": [
        "global_context",
        "runtime",
        "full_text_search"
      ],
      "signature": "FullTextSearch",
      "description": "Повнотекстовий пошук бази: пошук записів за словами їхніх полів. Глобальна властивість сервера, доступна за ім'ям.\n\nЩО ІНДЕКСУЄТЬСЯ — вирішують метадані: рядковий реквізит, у якого ввімкнено властивість «Повнотекстовий пошук», — довідника, документа чи плану, їхніх табличних частин, а також Найменування і Код довідника чи плану. Окремого списку ніде немає.\n\nІНДЕКС ВЕДЕТЬСЯ САМ. Слова запису пишуться разом із записом, у тій самій транзакції, і видаляються з його видаленням: немає ні черги, ні роботи після запису. На UpdateIndex лишається ПОБУДОВА — записи, записані до ввімкнення прапорця поля, до ввімкнення режиму або після ClearIndex. IndexTrue каже, чи лишилося що будувати.\n\nРЕЖИМ — БАЗИ: один для всіх сеансів, зберігається в базі, змінюється з правом «Адміністрування даних». У базі, де його ніхто не вмикав, — FullTextSearchMode.Disable; вимкнення очищує індекс.\n\nМишею: Адміністрування — Індекс повнотекстового пошуку вмикає режим і будує індекс; Сервіс — Знайти в даних шукає.",
      "syntax_block": "List = FullTextSearch.CreateList(\"front wheel\", 20);\nList.FirstPart();",
      "parameters": "",
      "return_descr": "",
      "example": "List = FullTextSearch.CreateList(\"front wheel\", 20);\nList.FirstPart();\nfor (i = 0; i < List.Count(); i++) {\n    Message(List.Get(i).Presentation);\n}",
      "availability": "Сервер",
      "see_also": [
        "cls.FullTextSearch.GetFullTextSearchMode",
        "cls.FullTextSearch.SetFullTextSearchMode",
        "cls.FullTextSearch.IndexTrue",
        "cls.FullTextSearch.UpdateIndex",
        "cls.FullTextSearch.ClearIndex",
        "cls.FullTextSearch.UpdateDate",
        "cls.FullTextSearch.CreateList",
        "cls.FullTextSearchList",
        "enum.FullTextSearchMode"
      ],
      "reviewed": false
    },
    {
      "id": "cls.FullTextSearch.GetFullTextSearchMode",
      "name_local": "GetFullTextSearchMode",
      "name_en": "GetFullTextSearchMode",
      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "full_text_search"
      ],
      "signature": "FullTextSearch.GetFullTextSearchMode() : FullTextSearchMode",
      "description": "Режим повнотекстового пошуку бази, як він зберігається в базі. Якщо нічого не збережено — FullTextSearchMode.Disable. Невідомий цій збірці режим відхиляється з його номером.",
      "syntax_block": "Mode = FullTextSearch.GetFullTextSearchMode();",
      "parameters": "",
      "return_descr": "FullTextSearchMode.",
      "example": "if (FullTextSearch.GetFullTextSearchMode() = FullTextSearchMode.Disable) {\n    Message(\"Full-text search is off\");\n}",
      "availability": "Сервер",
      "see_also": [
        "cls.FullTextSearch",
        "cls.FullTextSearch.SetFullTextSearchMode",
        "enum.FullTextSearchMode"
      ],
      "reviewed": false
    },
    {
      "id": "cls.FullTextSearch.SetFullTextSearchMode",
      "name_local": "SetFullTextSearchMode",
      "name_en": "SetFullTextSearchMode",
      "kind": "procedure",
      "category_keys": [
        "global_context",
        "runtime",
        "full_text_search"
      ],
      "signature": "FullTextSearch.SetFullTextSearchMode(mode : FullTextSearchMode)",
      "description": "Вмикає або вимикає повнотекстовий пошук бази для всіх сеансів. Потрібне право «Адміністрування даних». Після ввімкнення індекс порожній, і кожен наступний запис його веде — записане раніше будує UpdateIndex. Після вимкнення індекс очищується, і записи його більше не ведуть. Значення, що не є членом FullTextSearchMode, відхиляється.",
      "syntax_block": "FullTextSearch.SetFullTextSearchMode(FullTextSearchMode.Enable);",
      "parameters": "mode — член FullTextSearchMode: Enable або Disable.",
      "return_descr": "",
      "example": "FullTextSearch.SetFullTextSearchMode(FullTextSearchMode.Enable);\nFullTextSearch.UpdateIndex();",
      "availability": "Сервер",
      "see_also": [
        "cls.FullTextSearch",
        "cls.FullTextSearch.GetFullTextSearchMode",
        "cls.FullTextSearch.UpdateIndex",
        "enum.FullTextSearchMode"
      ],
      "reviewed": false
    },
    {
      "id": "cls.FullTextSearch.IndexTrue",
      "name_local": "IndexTrue",
      "name_en": "IndexTrue",
      "kind": "method",
      "category_keys": [
        "global_context",
        "runtime",
        "full_text_search"
      ],
      "signature": "FullTextSearch.IndexTrue() : boolean",
      "description": "Чи нічого більше будувати: кожен об'єкт з індексованими полями побудовано саме з цими полями, і нічого не проіндексовано для об'єкта, у якого їх більше немає. Записи ніколи не роблять його False — вони ведуть індекс самі; це роблять увімкнення чи вимкнення прапорця поля, увімкнення режиму і ClearIndex. При вимкненому режимі — False.",
      "syntax_block": "Built = FullTextSearch.IndexTrue();",
      "parameters": "",
      "return_descr": "Булеве.",
      "example": "while (!FullTextSearch.IndexTrue()) {\n    FullTextSearch.UpdateIndex(true);\n}",
      "availability": "Сервер",
      "see_also": [
        "cls.FullTextSearch",
        "cls.FullTextSearch.UpdateIndex",
        "cls.FullTextSearch.UpdateDate"
      ],
      "reviewed": false
    },
    {
      "id": "cls.FullTextSearch.UpdateIndex",
      "name_local": "UpdateIndex",
      "name_en": "UpdateIndex",
      "kind": "procedure",
      "category_keys": [
        "global_context",
        "runtime",
        "full_text_search"
      ],
      "signature": "FullTextSearch.UpdateIndex(portion : boolean = false)",
      "description": "Будує індекс для записів, яких у ньому ще немає: записаних до ввімкнення прапорця поля, до ввімкнення режиму або після ClearIndex. Записи читаються так, як зберігаються, — їхні модулі не виконуються. Кожна порція записів індексується у власній транзакції, тож зупинка між порціями зберігає побудоване. При вимкненому режимі відхиляється. Потрібне право «Адміністрування даних».\n\nОДИН АРГУМЕНТ. Аргументу злиття немає: кожен запис сам вливає свій запис в індекс. Виклик із двома аргументами — UpdateIndex(merge, portion) — відхиляється з поясненням: його перший аргумент було б прочитано як portion, а другий втрачено. Пишіть UpdateIndex(portion).",
      "syntax_block": "FullTextSearch.UpdateIndex(portion);",
      "parameters": "portion — True, щоб проіндексувати одну порцію записів (500) і повернутися; потім IndexTrue скаже, чи викликати знову. Не вказано — False: будується все, що лишилося.",
      "return_descr": "",
      "example": "// a scheduled job: one portion each run, until the index is built\nif (!FullTextSearch.IndexTrue()) {\n    FullTextSearch.UpdateIndex(true);\n}",
      "availability": "Сервер",
      "see_also": [
        "cls.FullTextSearch",
        "cls.FullTextSearch.IndexTrue",
        "cls.FullTextSearch.ClearIndex"
      ],
      "reviewed": false
    },
    {
      "id": "cls.FullTextSearch.ClearIndex",
      "name_local": "ClearIndex",
      "name_en": "ClearIndex",
      "kind": "procedure",
      "category_keys": [
        "global_context",
        "runtime",
        "full_text_search"
      ],
      "signature": "FullTextSearch.ClearIndex()",
      "description": "Очищує індекс: нічого не знаходиться, доки UpdateIndex не побудує його знову. Режим не змінюється, і записи далі індексують себе. Потрібне право «Адміністрування даних».",
      "syntax_block": "FullTextSearch.ClearIndex();",
      "parameters": "",
      "return_descr": "",
      "example": "FullTextSearch.ClearIndex();\nFullTextSearch.UpdateIndex();",
      "availability": "Сервер",
      "see_also": [
        "cls.FullTextSearch",
        "cls.FullTextSearch.UpdateIndex"
      ],
      "reviewed": false
    },
