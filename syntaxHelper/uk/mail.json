        "value_types",
        "runtime",
        "mail"
      ],
      "signature": "Profile.SMTPPort : number",
      "description": "Порт. Не заданий, читається як порт за захистом: 465 з SecureConnection, 25 без. 0 — не задано; число поза 1–65535 відхиляється.",
      "syntax_block": "Profile.SMTPPort = Value;",
      "parameters": "",
      "return_descr": "Число.",
      "example": "Profile.SMTPPort = 587;",
      "availability": "Клієнт, Сервер",
      "see_also": [
        "cls.InternetMailProfile",
        "cls.InternetMail.Logon"
      ],
      "reviewed": false
    },
