  "entries": [
    {
      "id": "cls.InternetMailProfile",
      "name_local": "InternetMailProfile",
      "name_en": "InternetMailProfile",
      "kind": "collection",
      "class_id": 166093668095330944,
      "category_keys": [
        "value_types",
        "runtime",
        "mail"
      ],
      "signature": "New InternetMailProfile()",
      "description": "Який поштовий сервер і хто на нього входить: адреса, порт, користувач і пароль, час на кожну відповідь і захист. InternetMail.Logon читає профіль у момент входу й лише тоді — профіль, змінений після, нічого не змінює до наступного Logon.\n\nЗАХИСТ — ЦЕ SecureConnection, той самий, що приймає HTTPConnection: з ним розмова йде по TLS — з першого байта на порту 465, через STARTTLS на будь-якому іншому (587, 25); сервер, що не пропонує STARTTLS, відхиляється, а не отримує пароль відкритим текстом. Без нього з'єднання відкрите.\n\nПОРТ, ЯКЩО НЕ ЗАДАНО, ВИЗНАЧАЄТЬСЯ ЗАХИСТОМ: 465 з SecureConnection, 25 без нього.",
      "syntax_block": "Profile = New InternetMailProfile();\nProfile.SMTPServerAddress = server;\nProfile.SecureConnection = New SecureConnection();",
      "parameters": "",
      "return_descr": "InternetMailProfile.",
      "example": "Profile = New InternetMailProfile();\nProfile.SMTPServerAddress = \"smtp.example.com\";\nProfile.SMTPUser = \"shop@example.com\";\nProfile.SMTPPassword = Password;\nProfile.SecureConnection = New SecureConnection();   // TLS on 465\n\nMessage = New InternetMailMessage();\nMessage.From = \"Shop <shop@example.com>\";\nMessage.To.Add(\"buyer@example.net\");\nMessage.Subject = \"Invoice 42\";\nMessage.Texts.Add(\"The invoice is attached.\");\nMessage.Attachments.Add(\"C:\\out\\invoice-42.pdf\");\n\nMail = New InternetMail();\nMail.Logon(Profile);\nMail.Send(Message);\nMail.Logoff();",
      "availability": "Клієнт, Сервер",
      "see_also": [
        "cls.InternetMail",
        "cls.InternetMailMessage",
        "cls.SecureConnection"
      ],
      "reviewed": false
    },
    {
      "id": "cls.InternetMailProfile.SMTPServerAddress",
      "name_local": "SMTPServerAddress",
      "name_en": "SMTPServerAddress",
      "kind": "property",
      "category_keys": [
        "value_types",
        "runtime",
        "mail"
      ],
      "signature": "Profile.SMTPServerAddress : string",
      "description": "Ім'я поштового сервера — `smtp.example.com`, без схеми й порту. Порожнє відхиляється під час Logon.",
      "syntax_block": "Profile.SMTPServerAddress = Value;",
      "parameters": "",
      "return_descr": "Рядок.",
      "example": "Profile = New InternetMailProfile();\nProfile.SMTPServerAddress = \"smtp.example.com\";\nProfile.SMTPUser = \"shop@example.com\";\nProfile.SMTPPassword = Password;\nProfile.SecureConnection = New SecureConnection();   // TLS on 465\n\nMessage = New InternetMailMessage();\nMessage.From = \"Shop <shop@example.com>\";\nMessage.To.Add(\"buyer@example.net\");\nMessage.Subject = \"Invoice 42\";\nMessage.Texts.Add(\"The invoice is attached.\");\nMessage.Attachments.Add(\"C:\\out\\invoice-42.pdf\");\n\nMail = New InternetMail();\nMail.Logon(Profile);\nMail.Send(Message);\nMail.Logoff();",
      "availability": "Клієнт, Сервер",
      "see_also": [
        "cls.InternetMailProfile",
        "cls.InternetMail.Logon"
      ],
      "reviewed": false
    },
    {
      "id": "cls.InternetMailProfile.SMTPPort",
