      "reviewed": false
    },
    {
      "id": "cls.InternetMailMessage",
      "name_local": "InternetMailMessage",
      "name_en": "InternetMailMessage",
      "kind": "collection",
      "class_id": 194000372725466810,
      "category_keys": [
        "value_types",
        "runtime",
        "mail"
      ],
      "signature": "New InternetMailMessage()",
      "description": "Лист: хто надсилає, кому, тема, тексти й вкладення. Адреса — рядок `buyer@example.net` або `Buyer <buyer@example.net>`; ім'я не в ASCII йде так, як вимагає формат, як і тема. Bcc доходить до своїх одержувачів і не видимий жодному з них.\n\nЛист іде як MIME: тексти й вкладення в base64, тому його передасть будь-який сервер. Переведення рядка в темі чи в адресі відхиляється під час надсилання — воно додало б свій заголовок.",
      "syntax_block": "Message = New InternetMailMessage();\nMessage.From = sender;\nMessage.To.Add(recipient);\nMessage.Texts.Add(text);",
      "parameters": "",
      "return_descr": "InternetMailMessage.",
      "example": "Profile = New InternetMailProfile();\nProfile.SMTPServerAddress = \"smtp.example.com\";\nProfile.SMTPUser = \"shop@example.com\";\nProfile.SMTPPassword = Password;\nProfile.SecureConnection = New SecureConnection();   // TLS on 465\n\nMessage = New InternetMailMessage();\nMessage.From = \"Shop <shop@example.com>\";\nMessage.To.Add(\"buyer@example.net\");\nMessage.Subject = \"Invoice 42\";\nMessage.Texts.Add(\"The invoice is attached.\");\nMessage.Attachments.Add(\"C:\\out\\invoice-42.pdf\");\n\nMail = New InternetMail();\nMail.Logon(Profile);\nMail.Send(Message);\nMail.Logoff();",
      "availability": "Клієнт, Сервер",
      "see_also": [
        "cls.InternetMail.Send",
        "cls.InternetMailTexts",
        "cls.InternetMailAttachments"
      ],
      "reviewed": false
    },
