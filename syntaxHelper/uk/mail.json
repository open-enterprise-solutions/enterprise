      "parameters": "",
      "return_descr": "",
      "example": "Message.Attachments.Add(\"C:\\out\\invoice-42.pdf\");\nBytes = New BinaryData(\"Paid in full.\", TextEncoding.UTF8);\nMessage.Attachments.Add(Bytes, \"receipt.txt\");",
