  "entries": [
    {
      "id": "enum.StatusMessage",
      "name_local": "StatusMessage",
      "name_en": "StatusMessage",
      "kind": "enum_type",
      "class_id": 430604137315061708,
      "category_keys": ["global_context", "system_enums"],
      "signature": "StatusMessage.Information, .Warning, .Error",
      "description": "Рівень повідомлення: другий аргумент Message і WriteJournalEvent. Якщо не вказано — Information. Вікно повідомлень малює повідомлення на його рівні, запуск під налагоджувачем передає рівень у конфігуратор разом із текстом, а рядок журналу записується з ним — саме за ним читач і відбирає.\n\nError — слово застосунку, а не платформи: повідомлення показується з рівнем помилки, а скрипт працює далі. Щоб зупинитися, викличте виняток (Raise).\n\nПорівнюйте значення зі значенням, а не з його текстом: `String(StatusMessage.Error)` дає підпис мовою користувача.",
      "syntax_block": "Message(text, StatusMessage.Warning);",
      "syntax_block_ves": "Message(text, StatusMessage.Warning);",
      "parameters": "",
      "return_descr": "StatusMessage.",
      "example": "Message(\"Документ не проведено: немає залишку.\", StatusMessage.Error);\nWriteJournalEvent(\"Рядок 17 пропущено: немає такого товару\", StatusMessage.Warning, \"import.line\");",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.StatusMessage.Information", "enum.StatusMessage.Warning", "enum.StatusMessage.Error", "fn.Message", "fn.WriteJournalEvent"],
      "reviewed": false
    },
    {
      "id": "enum.StatusMessage.Information",
      "name_local": "Information",
      "name_en": "Information",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "StatusMessage.Information",
      "description": "Звичайне повідомлення: щось сталося, уваги не потрібно. Значення за замовчуванням, коли рівень не вказано.",
      "syntax_block": "Message(text, StatusMessage.Information);",
      "parameters": "",
      "return_descr": "StatusMessage.",
      "example": "Message(\"Завантаження завершено: 1240 рядків.\", StatusMessage.Information);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.StatusMessage", "fn.Message"],
      "reviewed": false
    },
    {
      "id": "enum.StatusMessage.Warning",
      "name_local": "Warning",
      "name_en": "Warning",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "StatusMessage.Warning",
      "description": "На це варто подивитися; нічого не відхилено. Рядок журналу з цим рівнем записується як попередження.",
      "syntax_block": "Message(text, StatusMessage.Warning);",
      "parameters": "",
      "return_descr": "StatusMessage.",
      "example": "Message(\"Прайс-лист старший за місяць.\", StatusMessage.Warning);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.StatusMessage", "fn.Message", "fn.WriteJournalEvent"],
      "reviewed": false
    },
    {
      "id": "enum.StatusMessage.Error",
      "name_local": "Error",
      "name_en": "Error",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "StatusMessage.Error",
      "description": "Щось не вдалося або було відхилено. Повідомлення показується й записується в журнал з рівнем помилки; сам скрипт працює далі, якщо не викличе виняток.",
      "syntax_block": "Message(text, StatusMessage.Error);",
      "parameters": "",
      "return_descr": "StatusMessage.",
      "example": "Message(\"Документ не проведено: немає залишку.\", StatusMessage.Error);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.StatusMessage", "fn.Message", "fn.Raise"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode",
      "name_local": "QuestionMode",
      "name_en": "QuestionMode",
      "kind": "enum_type",
      "class_id": 412506258289495458,
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.YesNo, .YesNoCancel, .Ok, .OkCancel",
      "description": "Які кнопки пропонує Question: другий аргумент Question. Якщо не вказано — Ok, одна кнопка. Відповідь повертається значенням QuestionReturnCode за назвою натиснутої кнопки.\n\nЯкщо в сеансу немає вікна, де запитати (фонове завдання, скрипт без клієнта), Question відповідає Cancel, нічого не запитуючи; під час обчислення (спостереження в налагоджувачі, проба асистента) — порожнім значенням.",
      "syntax_block": "Answer = Question(text, QuestionMode.YesNo);",
      "syntax_block_ves": "Answer = Question(text, QuestionMode.YesNo);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Answer = Question(\"Провести документ?\", QuestionMode.YesNoCancel);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.QuestionMode.YesNo", "enum.QuestionMode.YesNoCancel", "enum.QuestionMode.Ok", "enum.QuestionMode.OkCancel", "enum.QuestionReturnCode", "fn.Question"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode.YesNo",
      "name_local": "YesNo",
      "name_en": "YesNo",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.YesNo",
      "description": "Дві кнопки, «Так» і «Ні». Відповідь — QuestionReturnCode.Yes або .No.",
      "syntax_block": "Answer = Question(text, QuestionMode.YesNo);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Answer = Question(\"Видалити чернетку?\", QuestionMode.YesNo);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.QuestionMode", "enum.QuestionReturnCode.Yes", "enum.QuestionReturnCode.No"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode.YesNoCancel",
      "name_local": "YesNoCancel",
      "name_en": "YesNoCancel",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.YesNoCancel",
      "description": "Три кнопки, «Так», «Ні» і «Скасувати» — для запитання, де «не зараз» не те саме, що «ні». Відповідь — QuestionReturnCode.Yes, .No або .Cancel.",
      "syntax_block": "Answer = Question(text, QuestionMode.YesNoCancel);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Answer = Question(\"Зберегти зміни перед закриттям?\", QuestionMode.YesNoCancel);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.QuestionMode", "enum.QuestionReturnCode"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode.Ok",
      "name_local": "Ok",
      "name_en": "Ok",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.Ok",
      "description": "Одна кнопка, «ОК». Значення за замовчуванням, коли режим не вказано. Відповідь — QuestionReturnCode.Ok.",
      "syntax_block": "Question(text, QuestionMode.Ok);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Question(\"Період закрито.\", QuestionMode.Ok);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.QuestionMode", "enum.QuestionReturnCode.Ok", "fn.Alert"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionMode.OkCancel",
      "name_local": "OkCancel",
      "name_en": "OkCancel",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionMode.OkCancel",
      "description": "Дві кнопки, «ОК» і «Скасувати» — продовжити або відступити. Відповідь — QuestionReturnCode.Ok або .Cancel.",
      "syntax_block": "Answer = Question(text, QuestionMode.OkCancel);",
      "parameters": "",
      "return_descr": "QuestionMode.",
      "example": "Answer = Question(\"Перерахувати всі рядки?\", QuestionMode.OkCancel);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.QuestionMode", "enum.QuestionReturnCode.Ok", "enum.QuestionReturnCode.Cancel"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode",
      "name_local": "QuestionReturnCode",
      "name_en": "QuestionReturnCode",
      "kind": "enum_type",
      "class_id": 430532751430419528,
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.Yes, .No, .Ok, .Cancel",
      "description": "Що відповідає Question: кнопку, яку натиснула людина. Порівнюйте зі значенням — `Answer = QuestionReturnCode.Yes`.\n\nЯкщо в сеансу немає вікна, де запитати (фонове завдання, скрипт без клієнта), відповідь — Cancel, а запитання не показується; під час обчислення (спостереження в налагоджувачі, проба асистента) — порожнє значення, що не дорівнює жодному зі значень переліку.",
      "syntax_block": "if (Question(text, QuestionMode.YesNo) = QuestionReturnCode.Yes) {\n    // людина погодилася\n}",
      "syntax_block_ves": "If Question(text, QuestionMode.YesNo) = QuestionReturnCode.Yes Then\n    // людина погодилася\nEndIf;",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "Answer = Question(\"Провести документ?\", QuestionMode.YesNo);\nPost = (Answer = QuestionReturnCode.Yes);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.QuestionReturnCode.Yes", "enum.QuestionReturnCode.No", "enum.QuestionReturnCode.Ok", "enum.QuestionReturnCode.Cancel", "enum.QuestionMode", "fn.Question"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode.Yes",
      "name_local": "Yes",
      "name_en": "Yes",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.Yes",
      "description": "Людина натиснула «Так» (QuestionMode.YesNo або .YesNoCancel).",
      "syntax_block": "if (Answer = QuestionReturnCode.Yes) { }",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "Agreed = (Question(\"Провести документ?\", QuestionMode.YesNo) = QuestionReturnCode.Yes);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.QuestionReturnCode", "enum.QuestionMode.YesNo"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode.No",
      "name_local": "No",
      "name_en": "No",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.No",
      "description": "Людина натиснула «Ні» (QuestionMode.YesNo або .YesNoCancel).",
      "syntax_block": "if (Answer = QuestionReturnCode.No) { }",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "Declined = (Answer = QuestionReturnCode.No);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.QuestionReturnCode", "enum.QuestionMode.YesNo"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode.Ok",
      "name_local": "Ok",
      "name_en": "Ok",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.Ok",
      "description": "Людина натиснула «ОК» (QuestionMode.Ok або .OkCancel).",
      "syntax_block": "if (Answer = QuestionReturnCode.Ok) { }",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "Go = (Question(\"Перерахувати всі рядки?\", QuestionMode.OkCancel) = QuestionReturnCode.Ok);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.QuestionReturnCode", "enum.QuestionMode.OkCancel"],
      "reviewed": false
    },
    {
      "id": "enum.QuestionReturnCode.Cancel",
      "name_local": "Cancel",
      "name_en": "Cancel",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "QuestionReturnCode.Cancel",
      "description": "Людина натиснула «Скасувати» — або запитати не було кого, бо в сеансу немає вікна (фонове завдання, скрипт без клієнта). Розумійте як «нічого не робити».",
      "syntax_block": "if (Answer = QuestionReturnCode.Cancel) { }",
      "parameters": "",
      "return_descr": "QuestionReturnCode.",
      "example": "StepBack = (Answer = QuestionReturnCode.Cancel);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.QuestionReturnCode", "enum.QuestionMode.OkCancel", "enum.QuestionMode.YesNoCancel"],
      "reviewed": false
    },
    {
      "id": "enum.RoundMode",
      "name_local": "RoundMode",
      "name_en": "RoundMode",
      "kind": "enum_type",
      "class_id": 409888286779662112,
      "category_keys": ["global_context", "system_enums"],
      "signature": "RoundMode.Round15as10, .Round15as20",
      "description": "Правило округлення: третій аргумент Round. Два правила розходяться лише на одному вході — РІВНО половині останнього збережуваного розряду. Round15as20 (за замовчуванням) відводить її від нуля, Round15as10 — до нуля; усе, що більше за половину, за обома правилами йде від нуля.\n\nВказуйте правило явно скрізь, де сума звіряється з іншою системою.",
      "syntax_block": "Value = Round(number, places, RoundMode.Round15as10);",
      "syntax_block_ves": "Value = Round(number, places, RoundMode.Round15as10);",
      "parameters": "",
      "return_descr": "RoundMode.",
      "example": "Message(Round(1.25, 1));                          // 1.3\nMessage(Round(1.25, 1, RoundMode.Round15as10));   // 1.2\nMessage(Round(1.251, 1, RoundMode.Round15as10));  // 1.3",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.RoundMode.Round15as10", "enum.RoundMode.Round15as20", "fn.Round"],
      "reviewed": false
    },
    {
      "id": "enum.RoundMode.Round15as10",
      "name_local": "Round15as10",
      "name_en": "Round15as10",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "RoundMode.Round15as10",
      "description": "Рівно половина йде до нуля: 1.5 стає 1, -1.5 стає -1. Більше за половину — як звичайно, від нуля: 1.51 і 1.6 стають 2.",
      "syntax_block": "Round(number, places, RoundMode.Round15as10)",
      "parameters": "",
      "return_descr": "RoundMode.",
      "example": "Message(Round(1.5, 0, RoundMode.Round15as10));   // 1",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.RoundMode", "fn.Round"],
      "reviewed": false
    },
    {
      "id": "enum.RoundMode.Round15as20",
      "name_local": "Round15as20",
      "name_en": "Round15as20",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "RoundMode.Round15as20",
      "description": "Рівно половина йде від нуля: 1.5 стає 2, -1.5 стає -2. Правило за замовчуванням, коли Round не передано інше.",
      "syntax_block": "Round(number, places, RoundMode.Round15as20)",
      "parameters": "",
      "return_descr": "RoundMode.",
      "example": "Message(Round(1.25, 1, RoundMode.Round15as20));   // 1.3",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.RoundMode", "fn.Round"],
      "reviewed": false
    },
    {
      "id": "enum.Chars",
      "name_local": "Chars",
      "name_en": "Chars",
      "kind": "enum_type",
      "class_id": 391176189795626039,
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.CR, .FF, .LF, .NBSp, .Tab, .VTab",
      "description": "Символи, яких не набрати в рядковому літералі, — за назвою. Значення ЧИТАЄТЬСЯ ЯК САМ СИМВОЛ: `\"a\" + Chars.LF + \"b\"` — два рядки завдовжки три символи, а `Asc(Chars.Tab)` дорівнює 9. Ті самі символи дає `Chr(code)`; назва каже, який саме мається на увазі.",
      "syntax_block": "Text = \"Перший рядок\" + Chars.LF + \"Другий рядок\";",
      "syntax_block_ves": "Text = \"Перший рядок\" + Chars.LF + \"Другий рядок\";",
      "parameters": "",
      "return_descr": "Рядок з одного символу.",
      "example": "Row = \"Папір\" + Chars.Tab + \"12\";\nText = \"Разом:\" + Chars.CR + Chars.LF + \"12 шт.\";\nMessage(StrLineCount(Text));   // 2",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.Chars.CR", "enum.Chars.FF", "enum.Chars.LF", "enum.Chars.NBSp", "enum.Chars.Tab", "enum.Chars.VTab", "fn.Chr", "fn.Asc", "fn.StrLineCount"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.CR",
      "name_local": "CR",
      "name_en": "CR",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.CR",
      "description": "Повернення каретки, код 13. Разом з LF — розрив рядка в текстових файлах, записаних у Windows. StrLineCount і StrGetLine вважають пару одним розривом, а одиночний CR — теж розривом.",
      "syntax_block": "Text = First + Chars.CR + Chars.LF + Second;",
      "parameters": "",
      "return_descr": "Рядок з одного символу.",
      "example": "Line = \"12 шт.\" + Chars.CR + Chars.LF;",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.Chars", "enum.Chars.LF", "fn.StrLineCount"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.FF",
      "name_local": "FF",
      "name_en": "FF",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.FF",
      "description": "Переведення сторінки, код 12 — розрив сторінки у простому тексті, надісланому на принтер.",
      "syntax_block": "Text = Page1 + Chars.FF + Page2;",
      "parameters": "",
      "return_descr": "Рядок з одного символу.",
      "example": "Text = \"Сторінка 1\" + Chars.FF + \"Сторінка 2\";",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.Chars"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.LF",
      "name_local": "LF",
      "name_en": "LF",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.LF",
      "description": "Переведення рядка, код 10. StrGetLine і StrLineCount ділять текст за ним.",
      "syntax_block": "Text = First + Chars.LF + Second;",
      "parameters": "",
      "return_descr": "Рядок з одного символу.",
      "example": "Message(\"Проведено: 12\" + Chars.LF + \"Пропущено: 3\");",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.Chars", "enum.Chars.CR", "fn.StrGetLine", "fn.StrLineCount"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.NBSp",
      "name_local": "NBSp",
      "name_en": "NBSp",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.NBSp",
      "description": "Нерозривний пробіл, код 160: на ньому рядок ніколи не переноситься — між числом і одиницею виміру, усередині числа з роздільниками розрядів. TrimAll не вважає його пробілом: замініть його, перш ніж чистити текст, що прийшов ззовні.",
      "syntax_block": "Text = Amount + Chars.NBSp + \"грн\";",
      "parameters": "",
      "return_descr": "Рядок з одного символу.",
      "example": "Clean = StrReplace(Imported, Chars.NBSp, \" \");",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.Chars", "fn.StrReplace"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.Tab",
      "name_local": "Tab",
      "name_en": "Tab",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.Tab",
      "description": "Горизонтальна табуляція, код 9 — роздільник колонок у тексті з табуляціями.",
      "syntax_block": "Row = Item + Chars.Tab + Quantity;",
      "parameters": "",
      "return_descr": "Рядок з одного символу.",
      "example": "Fields = StrSplit(Line, Chars.Tab);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.Chars", "fn.StrSplit"],
      "reviewed": false
    },
    {
      "id": "enum.Chars.VTab",
      "name_local": "VTab",
      "name_en": "VTab",
      "kind": "system_enum",
      "category_keys": ["global_context", "system_enums"],
      "signature": "Chars.VTab",
      "description": "Вертикальна табуляція, код 11. У тексті рідкісна; деякі вивантаження позначають нею розрив рядка всередині комірки.",
      "syntax_block": "Text = First + Chars.VTab + Second;",
      "parameters": "",
      "return_descr": "Рядок з одного символу.",
      "example": "Clean = StrReplace(Cell, Chars.VTab, Chars.LF);",
      "availability": "Клієнт, Сервер",
      "see_also": ["enum.Chars"],
      "reviewed": false
    }
  ]
}
