[submodule "3rdparty/wxWidgets"]
	path = src/3rdparty/wxWidgets
	url = https://github.com/wxWidgets/wxWidgets.git
[submodule "docs"]
	path = docs/private
	url = https://github.com/open-enterprise-solutions/enterprise-docs.git
	branch = main
	update = none
[submodule "src/3rdparty/cpp-httplib"]
	path = src/3rdparty/cpp-httplib
	url = https://github.com/yhirose/cpp-httplib.git
[submodule "src/3rdparty/mbedtls"]
	path = src/3rdparty/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls.git
[submodule "src/3rdparty/nlohmann"]
	path = src/3rdparty/nlohmann
	url = https://github.com/nlohmann/json.git
[submodule "src/3rdparty/asio"]
	path = src/3rdparty/asio
	url = https://github.com/chriskohlhoff/asio.git
[submodule "src/3rdparty/llhttp"]
	path = src/3rdparty/llhttp
	url = https://github.com/nodejs/llhttp.git
	branch = release
[submodule "src/3rdparty/lodepng"]
	path = src/3rdparty/lodepng
	url = https://github.com/lvandeve/lodepng.git
[submodule "src/3rdparty/nanosvg"]
	path = src/3rdparty/nanosvg
	url = https://github.com/memononen/nanosvg.git
