{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "oes": {
    "$description": "Provisional until the Iteration 1 reference screen validates these mappings.",
    "text": {
      "$type": "color",
      "$value": "var(--sapTextColor)"
    },
    "surface": {
      "$type": "color",
      "$value": "var(--sapField_Background)"
    },
    "border": {
      "$type": "color",
      "$value": "var(--sapField_BorderColor)"
    },
    "action": {
      "$type": "color",
      "$value": "var(--sapButton_Emphasized_Background)"
    },
    "focus": {
      "$type": "color",
      "$value": "var(--sapContent_FocusColor)"
    },
    "status": {
      "error": {
        "$type": "color",
        "$value": "var(--sapNegativeColor)"
      }
    }
  }
}
